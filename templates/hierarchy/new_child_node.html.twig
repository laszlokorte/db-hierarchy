{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    New {{key.label.singular}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,key, parentNodes} only %}

<h1><span data-prefix="{{key.label.singular}}">

    {%- include 'hierarchy/partials/icon.html.twig' with {icon: key.label.icon, prefix: true} only -%}
    {{ key.summarize(node) }}</span></h1>{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy,key, node, active: 'new', childKey} only %}

<h2>{{childKey.label.string(childKey.isSingleton)}}</h2>

{% if childKey.isSingleton %}

 <ul class="quicktab-list">

    <li class="quicktab-list-item"><a href="{{ path('list_child_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: node.id, childKeyId: childKey.id}) }}" for="child_tab_{{childKey.id}}_new" class="quicktab-link">
    {{childKey.label.empty}}
    </a></li>
    <li class="quicktab-list-item"><span for="child_tab_{{childKey.id}}_list" class="quicktab-link state-active">
    {{childKey.label.plural}}
    </span></li>
</ul>

{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'list', force_then: true, cancel: path('list_child_nodes', {hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId: node.id, childKeyId: childKey.id}), creationForm} only %}

{% else %}

{% include 'hierarchy/partials/sub_tabs.html.twig' with {hierarchy,active: 'new', key, node, childKey} only %}

{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'form', creationForm} only %}

{% endif %}



{% endblock %}
