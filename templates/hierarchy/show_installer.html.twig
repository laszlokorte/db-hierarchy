{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Installer - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,trailing: 'System'} only %}

<h1>Installer</h1>

<ul class="quicktab-list">
    {# <li class="quicktab-list-item"><a class="{{ html_classes('quicktab-link', {'state-active': subHierarchy.slug == hierarchy.slug}) }}" href="{{ path('show_system_installer', {hierarchySlug: hierarchy.slug}) }}">{{hierarchy.label.singular}}</a></li> #}
    {% for subSchema in subSchemas %}
        <li class="quicktab-list-item"><a class="{{ html_classes('quicktab-link', {'state-active': subHierarchy.slug == subSchema.slug}) }}" href="{{ path('show_system_installer', {hierarchySlug: hierarchy.slug, subHierarchySlug: subSchema.slug}) }}">{{subSchema.label.singular}}</a></li>
    {% endfor %}
</ul>

<h2>Schema</h2>

<details class="details">
    <summary class="details-summary">
    SQL
    </summary>

    <textarea contenteditable="false" readonly style="margin: 0; color: #0a0; overflow: scroll;resize: vertical;box-sizing: border-box;height: 50vh;box-sizing: border-box;white-space: pre-wrap; padding: 2em; width: 100%">
    {{- installer.getSchemaDeclerations -}}
    </textarea>

</details>
    {{ form_errors(installViewsForm) }}
    {{ form_errors(installForm) }}
    {{ form_errors(uninstallForm) }}

<div style="display: flex; justify-content: space-between; gap: 0.5em">
    <div style="display: flex; gap: 0.5em">
        {{ form_start(installViewsForm) }}
        {{ form_widget(installViewsForm.submit, {attr: {class:'action-button'}, label: 'Reinstall Views'}) }}
        {{ form_end(installViewsForm) }}
    </div>

    <div style="display: flex; gap: 0.5em">
        {{ form_start(installForm) }}
        {{ form_widget(installForm.submit, {attr: {class:'action-button danger'}}) }}
        {{ form_end(installForm) }}


        {{ form_start(uninstallForm) }}
        {{ form_widget(uninstallForm.submit, {attr: {class:'action-button danger'}}) }}
        {{ form_end(uninstallForm) }}
    </div>
</div>

<h2>Installation status</h2>

<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1em">
        {% set tableDiff = installer.getTableDiff() %}
        <div>
            <h3>Installed Tables</h3>
            {% if tableDiff.installed %}
            <ul class="inline-list">
                {% for tableName in tableDiff.installed %}
                    <li class="block-list-item"><a href="{{ path('show_system_installer_table', {hierarchySlug: hierarchy.slug, subHierarchySlug: subHierarchy.slug, tableName}) }}"><code class="badge" style="background-color:#080">{{tableName}}</code></a></li>
                {% endfor %}
            </ul>
            {% else %}
                <p>none</p>
            {% endif %}
        </div>
        <div>
            <h3>Missing Tables</h3>
            {% if tableDiff.missing %}
            <ul class="inline-list separator">
                {% for tableName in tableDiff.missing %}
                    <li class="block-list-item"><a href="{{ path('show_system_installer_table', {hierarchySlug: hierarchy.slug, subHierarchySlug: subHierarchy.slug, tableName}) }}"><code class="badge" style="background-color:#800">{{tableName}}</code></a></li>
                {% else %}
                    <li>No missing</li>
                {% endfor %}
            </ul>
            {% else %}
                <p>none</p>
            {% endif %}
        </div>
        <div>
            <h3>Left over Tables</h3>
            {% if tableDiff.leftOver %}
            <ul class="inline-list">
                {% for tableName in tableDiff.leftOver %}
                    <li class="block-list-item"><a href="{{ path('show_system_installer_table', {hierarchySlug: hierarchy.slug, subHierarchySlug: subHierarchy.slug, tableName}) }}"><code class="badge" style="background-color:#eee;color:#000">{{tableName}}</code></a></li>
                {% endfor %}
            </ul>
            {% else %}
                <p>none</p>
            {% endif %}
        </div>

        {% set viewDiff = installer.getViewDiff() %}
        <div>
            {% if viewDiff.installed %}
            <h3>Installed Views</h3>
            <ul class="inline-list">
                {% for viewName in viewDiff.installed %}
                    <li class="block-list-item"><a href="{{ path('show_system_installer_view', {hierarchySlug: hierarchy.slug, subHierarchySlug: subHierarchy.slug, viewName}) }}"><code class="badge" style="background-color:#080">{{viewName}}</code></a></li>
                {% endfor %}
            </ul>         
            {% else %}
                <p>none</p>
            {% endif %}   
        </div>  
        <div>
            <h3>Missing Views</h3>
            {% if viewDiff.missing %}
            <ul class="inline-list separator">
                {% for viewName in viewDiff.missing %}
                    <li class="block-list-item"><a href="{{ path('show_system_installer_view', {hierarchySlug: hierarchy.slug, subHierarchySlug: subHierarchy.slug, viewName}) }}"><code class="badge" style="background-color:#800">{{viewName}}</code></a></li>
                {% else %}
                    <li>No missing</li>
                {% endfor %}
            </ul>
            {% else %}
                <p>none</p>
            {% endif %}
        </div>
        <div>
            <h3>Left over Views</h3>
            {% if viewDiff.leftOver %}
            <ul class="inline-list">
                {% for viewName in viewDiff.leftOver %}
                    <li class="block-list-item"><a href="{{ path('show_system_installer_view', {hierarchySlug: hierarchy.slug, subHierarchySlug: subHierarchy.slug, viewName}) }}"><code class="badge" style="background-color:#eee;color:#000">{{viewName}}</code></a></li>
                {% endfor %}
            </ul>
            {% else %}
                <p>none</p>
            {% endif %}
        </div>      
</div>



{% endblock %}
