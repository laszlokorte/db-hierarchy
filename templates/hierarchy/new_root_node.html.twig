{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    New {{key.label.singular}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,key, parentNodes} only %}

<h1>{{key.label.string(key.isSingleton)}}</h1>



{% if key.isSingleton %}

 <ul class="quicktab-list">

    <li class="quicktab-list-item"><a href="{{ path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" for="child_tab_{{key.id}}_new" class="quicktab-link">
    {{key.label.empty}}
    </a></li>
    <li class="quicktab-list-item"><span for="child_tab_{{key.id}}_list" class="quicktab-link state-active">
    {{key.label.plural}}
    </span></li>
</ul>

{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'list', force_then: true, cancel: path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}), creation} only %}

{% else %}

{% include 'hierarchy/partials/sub_tabs.html.twig' with {hierarchy,active: 'new', key} only %}


{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy,then:'root_form', creation} only %}


{% endif %}

{% endblock %}