{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    New {{key.label.singular}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,key, parentNodes} only %}

<h1>{{key.label.string(key.isSingleton)}}
{%- if key.label.description is not empty -%}
<i class="icon-link info tooltipped" aria-label="{{key.label.description}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'info'} only %}</i>
{% endif %}
</h1>



{% if key.isSingleton and not key.isScoped %}

 <ul class="quicktab-list">

    <li class="quicktab-list-item"><a href="{{ path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" for="child_tab_{{key.id}}_new" class="quicktab-link">
    {{key.label.empty}}
    </a></li>
    <li class="quicktab-list-item"><span for="child_tab_{{key.id}}_list" class="quicktab-link state-active need-confirmation">
    {{key.label.plural}}
    </span></li>
</ul>

{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'list', force_then: true, cancel: path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}), creation} only %}

{% else %}

{% include 'hierarchy/partials/sub_tabs.html.twig' with {hierarchy,active: 'new', key} only %}


{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy,then:'root_form', creation} only %}

{{ form_start(creationForm) }}

{{ form_errors(creationForm) }}

<dl class="form-container">
   {% if creationForm._nesting is defined %}
      <dt class="form-container-label">{{ form_label(creationForm._nesting) }}</dt>
       <dd class="form-container-field">
       {{ form_widget(creationForm._nesting) }}
       {{ form_errors(creationForm._nesting) }}
       </dd>
       {% if creationForm._nesting.vars.help is not empty %}
       <dd class="form-container-info">
       <i class="icon-link info tooltipped" aria-label="{{creationForm._nesting.vars.help}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'info'} only %}</i>
       </dd>
       {% endif %}
   {% endif %}

   {% for field in creationForm.fields %}
       <dt class="form-container-label">{{ form_label(field) }}</dt>
       <dd class="form-container-field">
       {{ form_widget(field) }}
       {{ form_errors(field) }}
       </dd>
       {% if field.vars.help is not empty %}
       <dd class="form-container-info">
       <i class="icon-link info tooltipped" aria-label="{{field.vars.help}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'info'} only %}</i>
       </dd>
       {% endif %}
   {% endfor %}
   <dt class="form-container-label form-container-spacer"></dt>
   <dd class="form-container-buttons">
      {% for field in creationForm.buttons %}
          {{ form_widget(field) }}
      {% endfor %}
   </dd>
</dl>

{{ form_end(creationForm) }}

{% endif %}

{% endblock %}