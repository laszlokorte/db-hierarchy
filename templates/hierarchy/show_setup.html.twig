{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Setup - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,trailing: 'Setup'} only %}

<h1>Hierarchy Schema</h1>

<details class="details">
    <summary class="details-summary">
    Schema
    <div style="margin-left: auto;">
        <form style="display: contents;" action="{{ path('hierarchy_setup', {hierarchySlug: hierarchy.slug})}}" method="post" accept-charset="utf-8">
        <button name="only_views" value="1">Reinstall Views</button>
        <button>Reinstall Schema</button>
        </form>
        <form style="display: contents;" action="{{ path('hierarchy_uninstall', {hierarchySlug: hierarchy.slug})}}" method="post" accept-charset="utf-8">
        <button>Uninstall</button>
        </form>
    </div>
    </summary>

    <pre contenteditable="false" readonly style="margin: 0; color: #0a0; overflow: scroll;resize: vertical;box-sizing: border-box;height: 50vh;box-sizing: border-box;white-space: pre-wrap; padding: 2em">
    {{- installer.getSchemaDeclerations -}}
    </pre>

</details>

{% if systemHierarchy == hierarchy %}
<h2>Other Schemas</h2>

<ul class="block-list">
    {% for subSchema in subSchemas %}
        <li class="block-list-item"><a href="{{ path('show_hierarchy_setup', {hierarchySlug: subSchema.slug}) }}">{{subSchema.label.singular}}</a></li>
    {% endfor %}
</ul>

{% endif %}
{% endblock %}