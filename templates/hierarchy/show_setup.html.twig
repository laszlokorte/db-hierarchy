{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Setup - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {trailing: 'Setup'} only %}

<h1>Hierarchy Schema</h1>




<details class="details">
        <summary class="details-summary">
        Schema
        <form style="margin-left: auto;" action="{{ path('show_hierarchy_setup')}}" method="post" accept-charset="utf-8">
        <button>Reinstall Schema</button>
        </form>
        </summary>

<div contenteditable="" readonly style="overflow: scroll;height: 50vh; max-width: 50vw; width: 100%;resize: vertical;">
<pre style="margin: 0; color: #0a0">
{{- installer.getSchemaDeclerations -}}
</pre>

</div>
</details>

{% endblock %}