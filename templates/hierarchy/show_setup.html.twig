{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Setup - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {trailing: 'Setup'} only %}

<h1>Hierarchy Schema</h1>

<form action="{{ path('show_hierarchy_setup')}}" method="post" accept-charset="utf-8">
<button>Reload Schema</button>
</form>


<div contenteditable="" readonly style="overflow: scroll;max-height: 70vh; max-width: 50vw; width: 100%;">
{% for view in schema.allViews|reverse %}
<pre style="margin: 0; color: #a00">
{{- adapter.dropViewToString(view) -}}
</pre>
{% endfor -%}
{% for table in schema.allTables|reverse %}
<pre style="margin: 0; color: #a00">
{{- adapter.dropTableToString(table) -}}
</pre>
{% endfor -%}
{% for table in schema.allTables %}
<pre style="margin: 0; color: #55a">
{{- adapter.createTableToString(table) -}}
</pre>
{% endfor -%}
{% for view in schema.allViews %}
<pre style="margin: 0; color: #0a0">
{{- adapter.createViewToString(view) -}}
</pre>
{% endfor -%}

{% endblock %}