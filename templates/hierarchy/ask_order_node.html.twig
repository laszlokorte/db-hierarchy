{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Reorder {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}


{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,key, parentNodes} only %}

<h1><span data-prefix="{{key.label.singular}}">{{ key.summarize(node) }}</span></h1>
{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy: hierarchy,key, node, active: 'order'} only %}

<h2>Reorder</h2>


{{ form_start(orderForm) }}

{{ form_errors(orderForm) }}

<dl class="form-container">
  <dt class="form-container-label">{{ form_label(orderForm.new_position) }}</dt>
   <dd class="form-container-field">
   {{ form_widget(orderForm.new_position) }}
   {{ form_errors(orderForm.new_position) }}
   </dd>
   {% if orderForm.new_position.vars.help is not empty %}
   <dd class="form-container-info">
   <i class="icon-link info tooltipped" aria-label="{{orderForm.new_position.vars.help}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'question'} only %}</i>
   </dd>
   {% endif %}
   <dt class="form-container-label form-container-spacer"></dt>
   <dd class="form-container-buttons">
      {% for field in orderForm.buttons %}
          {{ form_widget(field) }}
      {% endfor %}
   </dd>
</dl>

{{ form_end(orderForm) }}

{% endblock %}