<div 
    class="dragger" 
    draggable="true" 
    data-nest-id="{{keyId}}-{{nestId}}" 
    data-order="{{order}}" 
    data-url="{{url('order_node',{hierarchySlug: hierarchy.slug, keyId, nodeId})}}" 
    ondragstart="event.dataTransfer.setData('order-url', this.dataset.url);event.dataTransfer.setData('nestId', this.dataset.nestId);this.classList.add('state-dragging');document.querySelectorAll('[data-nest-id=\''+this.dataset.nestId+'\']').forEach(e=>e.classList.add('drag-target'));document.body.classList.add('state-dragging')" 
    ondragend="this.classList.remove('state-dragging');document.querySelectorAll('.drag-target').forEach(e=>e.classList.remove('drag-target'));document.body.classList.remove('state-dragging')" 
    ondragover="if(event.dataTransfer.getData('nestId')==this.dataset.nestId) {this.classList.add('state-over');event.preventDefault()}" 
    ondragleave="this.classList.remove('state-over')" 
    ondrop="
        if(event.dataTransfer.getData('order-url')) {
            event.stopPropagation()
            this.classList.remove('state-over');document.body.classList.remove('state-dragging');document.querySelectorAll('.drag-target').forEach(e=>e.classList.remove('drag-target'))
            let fd = new FormData();
            fd.append('target_order', this.dataset.order);
            fd.append('_then', '{{then}}');
            fetch(event.dataTransfer.getData('order-url'), {
              method: 'POST',
              body: fd
            }).then((r) => {
                if(r.url != window.location.href) {
                window.location.href = r.url
            } else {
                window.location.reload()
            }})  
        }
    ">
    {% include 'hierarchy/partials/icon.html.twig' with {icon: 'three-bars'} only %}
    </div>