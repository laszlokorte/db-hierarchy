{% set key = hierarchy.getKey(ordering.keyId) %}

<form novalidate="" action="{{ path('order_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: ordering.nodeId}) }}" method="post" accept-charset="utf-8">
     <dl class="form-container">
        {% if not ordering.isValid %}
            <dt class="form-container-label form-container-spacer">
            </dt>
            <dd class="form-container-field">
            {% include 'hierarchy/partials/validation_errors.html.twig' with {key, errors: ordering.allErrors, message: 'could not be ordered'} only %}
            </dd>
        {% endif %}

        <dt class="form-container-label"><label class="target_order" for="target_scope-parent">New Position</label></dt>
        <dd class="form-container-field">
                
            {% set down = false %}
            {% set prevId = 'Top' %}
            <select class="form-select" name="target_order" required="">
                {% for id in orderTargets.ids %}
                    {% if id==ordering.nodeId %}
                        {% set down = true %}
                        <option disabled="" value="">{{ prevId }}</option>
                        <option value="{{orderTargets.order(id)}}" selected="selected">
                         (current position)</option>
                    {% elseif down %}
                        <option disabled="" value="">{{key.summarize(orderTargets.node(id), true)}}</option>
                        <option value="{{orderTargets.order(id)}}">put here</option>
                    {% else %}
                        <option disabled="" value="">{{ prevId }}</option>
                        <option value="{{orderTargets.order(id)}}">put here</option>
                    {% endif %}
                    {% set prevId = key.summarize(orderTargets.node(id), true) %}
                {% endfor %}
                    <option disabled="" value="">Bottom</option>
            </select>


        </dd>
        <dt class="form-container-label form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <button class="form-button primary">Reorder</button>
        </dd>
    </dl>
</form>

