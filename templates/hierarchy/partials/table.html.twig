<div class="data-table-scroller">
    <table class="data-table">
        <caption class="data-table-caption">List of {{key.label.plural}}</caption>
        <colgroup>
        {% if key.ordered %}
        <col class="data-table-col" />
        {% endif %}
        <col class="data-table-col" />
        </colgroup>
        {% if key.fields %}
        <colgroup>
            {% for field in key.fields %}
            <col class="data-table-col" />
            {% endfor %}
        </colgroup>
        {% endif %}
        <colgroup>
        <col class="data-table-col" />
        </colgroup>
        {% if key.nestedKeys %}
        <colgroup>
            {% for nested in key.nestedKeys %}
            <col class="data-table-col" />
            {% endfor %}
        </colgroup>
        {% endif %}
        <colgroup>
        <col class="data-table-col" />
        </colgroup>
        <thead class="data-table-head">
            <tr class="data-table-head-row">
                {% if key.ordered %}
                <th class="data-table-head-cell" width="5%">Sort</th>
                {% endif %}
                <th class="data-table-head-cell" width="5%">ID</th>
                {% if not nodeCollection.isScoped and key.isScoped %}
                <th class="data-table-head-cell" width="5%">{{key.scopeKey.label.singular}}</th>
                {% endif %}
                {% for field in key.fields %}
                <th class="data-table-head-cell">{{ field.label.singular }}</th>
                {% endfor %}
                <th class="data-table-head-cell" width="50%"></th>
                {% for nested in key.nestedKeys %}
                <th class="data-table-head-cell spacer" align="center">{{ nested.label.plural }}</th>
                {% endfor %}
                <th class="data-table-head-cell spacer sticky-end" align="right">Actions</th>
            </tr>
        </thead>
        {% if not nodeCollection.isEmpty %}
            <tbody class="data-table-body">
                {% for nodeId in nodeCollection.ids %}
                    <tr class="data-table-row">
                        {% if key.ordered %}
                            <td class="data-table-cell">
                            {% include 'hierarchy/partials/dragger.html.twig' with {hierarchy: hierarchy,then, keyId:key.id, nestId: nodeCollection.getNodeNestId(nodeId), nodeId, order:nodeCollection.order(nodeId)} only %}
                                
                            </td>
                        {% endif %}
                        <td class="data-table-cell type-id"><a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId}) }}">{{ nodeId }}</a></td>
                        {% if not nodeCollection.isScoped and key.isScoped %}
                        <td class="data-table-cell type-id"><a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: key.scopeKey.id, nodeId: nodeCollection.nodeScope(nodeId)}) }}">{{ nodeCollection.nodeScope(nodeId) }}</a>
                        </td>
                        {% endif %}
                        {% for field in key.fields %}
                            <td class="{{ html_classes('data-table-cell', {'empty': not field.hasValue(nodeCollection.getNode(nodeId))}) }}">
                            {{ block('cell', 'hierarchy/types/'~ field.templateName ~'.html.twig') }}
                            </td>
                        {% endfor %}
                        <td></td>
                        {% for nested in key.nestedKeys %}
                        <td class="data-table-cell" align="center">
                            <a class="faded-link" href="{{ path('list_child_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId,childKeyId:nested.id}) }}" title="{{ nested.label.plural }}">Show</a>
                        </td>
                        {% endfor %}
                        <td class="data-table-cell actions sticky-end" align="right">
                            {% if quickDelete??false %}
                            <form class="inline-form" action="{{ path('delete_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId}) }}" method="post" accept-charset="utf-8">
                                {% if then is defined %}
                                <input type="hidden" name="_then" value="{{then}}">
                                {% endif %}
                                <button class="inline-button">X</button>
                            </form>
                            {% else %}
                            <form class="inline-form quickform-inline" action="{{ path('delete_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId}) }}" method="post" accept-charset="utf-8">
                                {% if then is defined %}
                                <input type="hidden" name="_then" value="{{then}}">
                                {% endif %}
                                <button class="inline-button">X</button>
                            </form>
                            <a href="{{ path('ask_delete_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId}) }}" title="">Delete</a>
                            {% endif %}
                            <a href="{{ path('edit_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId}) }}" title="">Edit</a>
                        </td>
                    </tr>
                {% endfor %}

            </tbody>
        {% else %}
            <tbody>
                <tr class="data-table-empty-row">
                    {% if parent is defined %}
                    <td class="data-table-empty-cell" colspan="{{ key.fields|length + key.nestedKeys|length + 3 + (key.ordered?1:0) }}">Empty<br><a href="{{ path('new_child_node', parent|merge({hierarchySlug: hierarchy.slug, childKeyId: key.id})) }}" title="">Add first {{key.label.singular}}</a>
                    </td>
                    {% else %}
                    <td class="data-table-empty-cell" colspan="{{ key.fields|length + key.nestedKeys|length + 3 + (key.ordered?1:0) + (not nodeCollection.isScoped and key.isScoped?1:0) }}">Empty<br><a href="{{ path('new_root_node', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" title="">Add first {{key.label.singular}}</a>
                    </td>
                    {% endif %}
                </tr>
            </tbody>
        {% endif %}
        <tfoot class="data-table-foot">
            <tr class="data-table-foot-row">
                {% if parent is defined %}
                    <td class="data-table-foot-cell sticky-start" colspan="{{ key.fields|length + 1 + (key.ordered?1:0) }}">
                    {% if listLink??false %}
                        <a href="{{ path('list_child_nodes', parent|merge({hierarchySlug: hierarchy.slug, childKeyId: key.id})) }}" title="">Show {{key.label.plural}}</a>
                    {% endif %}
                    </td>
                    <td class="data-table-foot-cell sticky-end" align="right" colspan="{{key.nestedKeys|length + 2 + (not nodeCollection.isScoped and key.isScoped?1:0) }}" >
                        <a href="{{ path('new_child_node', parent|merge({hierarchySlug: hierarchy.slug, childKeyId: key.id})) }}" title="">New {{key.label.singular}}</a>
                    </td>
                {% else %}
                    <td class="data-table-foot-cell sticky-start" colspan="{{ key.fields|length + 1 + (key.ordered?1:0) }}">
                    {% if listLink??false %}
                        <a href="{{ path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" title="">Show {{key.label.plural}}</a>
                    {% endif %} 
                    </td>
                    <td class="data-table-foot-cell sticky-end" colspan="{{key.nestedKeys|length + 2 + (not nodeCollection.isScoped and key.isScoped?1:0) }}"  align="right">
                        <a href="{{ path('new_root_node', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" title="">New {{key.label.singular}}</a>
                    </td>
                {% endif %}
            </tr>
        </tfoot>
    </table>
</div>