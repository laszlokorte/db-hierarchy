
{% if not validation.isValid??true %}
{% include 'hierarchy/partials/validation_errors.html.twig' with {key, validation} only %}
{% endif %}

<form action="{{ path('delete_node',{hierarchySlug: hierarchy.slug, keyId: key.id, nodeId:node.id}) }}" method="post" accept-charset="utf-8">
    {% if deletionPlan.willDelete.nodesFor(key.id).count > 1 or deletionPlan.willDelete.getKeys()|length > 1 %}
        <div class="warning-box">
            <h3 style="margin: 0">Warning: This {{ key.label.singular }} has associated child nodes</h3>
            <p>Following nodes will also be deleted:</p>

            <dl class="keyvalue-container">
                {% for keyId in deletionPlan.willDelete.getKeys() %}
                    <dt class="keyvalue-container-label top">{{hierarchy.getKey(keyId).label.plural}}</dt>
                    <dd class="keyvalue-container-field wide">
                        <ul class="inline-list separator">
                            {% for nodeId in deletionPlan.willDelete.getNodesFor(keyId).getIds() %}
                                <li><a href="{{path('show_node',{hierarchySlug: hierarchy.slug, keyId, nodeId})}}">{{hierarchy.getKey(keyId).summarize(deletionPlan.willDelete.getNodesFor(keyId).getNode(nodeId))}}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endfor %}
            </dl>
        </div>
        {% else %}
            <div class="approve-box">This node does not have any child nodes.</div>
        {% endif %}

    {% if not deletionPlan.blockers.isEmpty %}
        <div class="warning-box">
            <h3 style="margin: 0">Node can not be deleted.</h3>

            <p>
                There are one or more references from other nodes to the nodes to be deleted. Please remove these references.
            </p>

            <dl class="keyvalue-container">
                {% for keyId in deletionPlan.blockers.keys %}
                    <dt class="keyvalue-container-label top">{{hierarchy.getKey(keyId).label.plural}}</dt>
                    <dd class="keyvalue-container-field wide">
                        <ul class="inline-list separator">
                            {% for nodeId in deletionPlan.blockers.getNodesFor(keyId).getIds() %}
                                <li><a href="{{path('show_node',{hierarchySlug: hierarchy.slug, keyId, nodeId})}}">{{hierarchy.getKey(keyId).summarize(deletionPlan.blockers.getNodesFor(keyId).getNode(nodeId))}}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endfor %}
            </dl>
        </div>
    {% else %}
            <p>
                Are you sure you want to delete this {{ key.label.singular }}?
            </p>

            <dl class="form-container">
                <dt class="form-container-spacer"></dt>
                <dd class="form-container-buttons">
                    <button class="action-button danger">Yes, Delete!</button>
                    <a class="link-button" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId:node.id}) }}" title="cancel">Cancel</a>
                </dd>
            </dl>
    {% endif %}
</form>