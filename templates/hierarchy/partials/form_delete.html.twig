{% set key = hierarchy.getKey(deletion.keyId) %}

<form action="{{ path('delete_node',{hierarchySlug: hierarchy.slug, keyId: key.id, nodeId:deletion.nodeId}) }}" method="post" accept-charset="utf-8">
    {% if deletion.isCascading %}
        <div class="warning-box">
            <h3 style="margin: 0">Warning: This {{ key.label.singular }} has associated child nodes</h3>
            <p>Following nodes will also be deleted:</p>

            <dl class="keyvalue-container">
                {% for keyId in deletion.cascadingKeys %}
                    <dt class="keyvalue-container-label top">{{hierarchy.getKey(keyId).label.string(hierarchy.getKey(keyId).isSingleton)}}</dt>
                    <dd class="keyvalue-container-field wide">
                        <ul class="inline-list separator">
                            {% for nodeId in deletion.cascadingIdsFor(keyId) %}
                                <li><a href="{{path('show_node',{hierarchySlug: hierarchy.slug, keyId, nodeId})}}">{{hierarchy.getKey(keyId).summarize(deletion.cascadingNodeFor(keyId, nodeId))}}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endfor %}
            </dl>
        </div>
        {% else %}
            <div class="approve-box">This node does not have any child nodes.</div>
        {% endif %}

    {% if deletion.isBlocked %}
        <div class="warning-box">
            <h3 style="margin: 0">Node can not be deleted.</h3>

            <p>
                There are one or more references from other nodes to the nodes to be deleted. Please remove these references.
            </p>

            <dl class="keyvalue-container">
                {% for keyId in deletion.blockingKeys %}
                    <dt class="keyvalue-container-label top">{{hierarchy.getKey(keyId).label.string(hierarchy.getKey(keyId).isSingleton)}}</dt>
                    <dd class="keyvalue-container-field wide">
                        <ul class="inline-list separator">
                            {% for nodeId in deletion.blockinNodesFor(keyId).getIds() %}
                                <li><a href="{{path('show_node',{hierarchySlug: hierarchy.slug, keyId, nodeId})}}">{{hierarchy.getKey(keyId).summarize(deletion.blockinNodesFor(keyId, nodeId))}}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endfor %}
            </dl>
        </div>
    {% else %}
            <p>
                Are you sure you want to delete this {{ key.label.singular }}?
            </p>

            <dl class="form-container">
                <dt class="form-container-spacer"></dt>
                <dd class="form-container-buttons">
                    <button class="action-button danger">Yes, Delete!</button>
                    <a class="link-button" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId:deletion.nodeId}) }}" title="cancel">Cancel</a>
                </dd>
            </dl>
    {% endif %}
</form>

{{ form(deletionForm) }}