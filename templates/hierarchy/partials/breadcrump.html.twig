<ul class="breadcrump outer">
    <li class="breadcrump-item"><a href="{{ path('hierarchy_root') }}">Root</a></li>
    {%- if key is defined -%}
        {%- for k in key.getNestingPath -%}
            {% if parentNodes.hasNodesFor(k.id) %}
                {% for nodeId in parentNodes.nodesFor(k.id).ids|default([]) %}
                    {% if loop.first %}
                        <li class="breadcrump-segment">{#--#}
                        {% if k.isScoped %}
                            <a class="breadcrump-segment-title" href="{{ path('list_child_nodes', {key: k.scopeKey.id, id: parentNodes.nodesFor(k.scopeKey.id).ids|last, childKey:k.id}) }}" title="">{{ k.label.plural }}</a>
                        {% else %}
                            <a class="breadcrump-segment-title" href="{{ path('list_root_nodes', {key:k.id}) }}" title="">{{ k.label.plural }}</a>
                        {% endif %}
                        <span class="breadcrump-item">
                    {% else %}
                        <li class="breadcrump-item">{#--#}
                    {% endif %}
                    {% if loop.last and loop.parent.loop.last and trailing is not defined %}
                        {{ k.summarize(parentNodes.nodesFor(k.id).getNode(nodeId)) }}
                    {% elseif key.reflexive %}
                        <a href="{{ path('list_child_nodes', {key:k.id, id:nodeId, childKey: k.id}) }}" title="">{{ k.summarize(parentNodes.nodesFor(k.id).getNode(nodeId)) }}</a>
                    {% else %}
                        <a href="{{ path('show_node', {key:k.id, id:nodeId}) }}" title="">{{ k.summarize(parentNodes.nodesFor(k.id).getNode(nodeId)) }}</a>
                    {% endif %}
                    {% if loop.first %}</span>{% endif %}
                    </li>
                {% endfor %}
            {% else %}
                <li class="{{html_classes('breadcrump-item')}}">{#--#}
                    {% if loop.last %}
                        {{ k.label.plural }}
                    {% elseif k.isScoped %}
                        <a href="{{ path('list_root_nodes', {key:k.id}) }}" title="">{{ k.label.plural }}</a>
                    {% else %}
                    <a href="{{ path('list_root_nodes', {key:k.id}) }}" title="">{{ k.label.plural }}</a>
                    {% endif %}
                </li>
            {% endif %}
        {%- endfor -%}
    {%- endif -%}

    {%- if trailing|default(false) -%}
    <li class="breadcrump-item">{{ trailing|capitalize }}</li>
    {%- endif -%}
</ul>








