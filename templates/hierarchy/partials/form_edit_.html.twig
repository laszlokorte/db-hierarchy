<form action="{{ path('update_node',{key:key.id, id}) }}" method="post" accept-charset="utf-8">
	{% if then is defined %}
	<input type="hidden" name="_then" value="{{then}}">
	{% endif %}

	{% if parent is defined %}
	{% if parent.key == key %}
        <input type="hidden" name="scope" value="{{ parent.scope }}">
        <input type="hidden" name="parent" value="{{ parent.id }}">
    {% else %}
        <input type="hidden" name="scope" value="{{ parent.id }}">
    {% endif %}
	{% endif %}
	
	<dl class="form-container">
		{% for field in key.fields %}
        <dt class="form-container-label">
        <label class="form-label" for="field_{{field.id}}">{{field.label.singular}}</label>
        <a class="icon-link" href="{{ path('show_node_field',{key:key.id, id, field: field.id}) }}" title="" target="_blank">➥</a>
        </dt>
        <dd class="form-container-field">
        <input class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}]" value="{{values[field.id]|join}}">
    	</dd>
    	{% endfor %}

	<dt class="form-container-spacer"></dt>
	<dd class="form-container-buttons"><button class="form-button">Update</button></dd>
    </dl>
</form>