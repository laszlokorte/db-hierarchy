{% set key = hierarchy.getKey(update.keyId) %}

<form novalidate="" action="{{ path('update_node',{hierarchySlug: hierarchy.slug, keyId:key.id, nodeId: update.nodeId}) }}" method="post" accept-charset="utf-8">
	{% if then is defined %}
	<input type="hidden" name="_then" value="{{then}}">
	{% endif %}

	<dl class="form-container">
		{% if not update.isValid %}
			<dt class="form-container-label form-container-spacer">
			</dt>
			<dd class="form-container-field">
	       	{% include 'hierarchy/partials/validation_errors.html.twig' with {key, errors: update.allErrors, message: 'could not be updated'} only %}
	    	</dd>
		{% endif %}

		{% for field in key.fields %}
        <dt class="{{ html_classes('form-container-label', {'state-error': update.fieldHasErrors(field.id)}) }}">
        <label class="{{ html_classes('form-label', {'state-error': update.fieldHasErrors(field.id)}) }}" for="field_{{field.id}}">{{field.label.singular}}</label>
        </dt>
        <dd class="{{ html_classes('form-container-field', {'state-error': update.fieldHasErrors(field.id)}) }}">
        
        <div>
        	{{ block('field', 'hierarchy/types/'~ field.templateName ~'.html.twig') }}
        </div>
    	
    	{% if update.fieldHasErrors(field.id) %}
    	<ul class="inline-list error">
    		{% for e in update.fieldErrors(field.id) %}
    	    <li>{{e}}</li>
    		{% endfor %}
    	</ul>
    	{% endif %}
    	<dd class="form-container-info">
        <a class="icon-link" href="{{ path('show_node_field',{hierarchySlug: hierarchy.slug, keyId:key.id, nodeId: update.nodeId, fieldId: field.id}) }}" title="" target="_blank">⋯</a>
    	</dd>

    	{% if field.label.description %}
    	<dd class="form-container-info">
	        <i class="icon-link info" title="{{field.label.description}}" target="_blank">i</i>
    	</dd>
    	{% endif %}

    	{% endfor %}

	<dt class="form-container-label form-container-spacer"></dt>
	<dd class="form-container-buttons">
	{% if force_then??false %}
		<button class="form-button primary">Save Changes</button>
	{% else %}
		<button class="form-button primary">Update</button>
		<button class="form-button" name="_then" value="show">Update and back</button>
	{% endif %}
	{% if cancel is defined %}
		{% if cancel is same as(true) %}
			<button class="link-button" type="reset">Reset</button>
		{% else %}
			<a class="link-button" href="{{ cancel }}" title="">Cancel</a>
		{% endif %}
	{% endif %}
	</dd>
    </dl>
</form>