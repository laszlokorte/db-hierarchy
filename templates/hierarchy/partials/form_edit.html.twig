<form action="{{ path('update_node',{key:key.id, id: node.id}) }}" method="post" accept-charset="utf-8">
	{% if then is defined %}
	<input type="hidden" name="_then" value="{{then}}">
	{% endif %}
	
	<dl class="form-container">
		{% for field in key.fields %}
        <dt class="form-container-label">
        <label class="form-label" for="field_{{field.id}}">{{field.label.singular}}</label>
        </dt>
        <dd class="form-container-field">
        <input class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}]" value="{{field.readValueOf(node)}}">
    	</dd>
    	<dd class="form-container-info">
        <a class="icon-link" href="{{ path('show_node_field',{key:key.id, id: node.id, field: field.id}) }}" title="" target="_blank">🡕</a>
    	</dd>
    	{% endfor %}

	<dt class="form-container-label form-container-spacer"></dt>
	<dd class="form-container-buttons"><button class="form-button primary">Update</button></dd>
    </dl>
</form>