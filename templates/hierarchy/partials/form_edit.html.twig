{{ form_start(editForm) }}

{{ form_errors(editForm) }}

<dl class="form-container">
   {% if editForm._nesting is defined %}
      <dt class="form-container-label">{{ form_label(editForm._nesting) }}</dt>
       <dd class="form-container-field">
       {{ form_widget(editForm._nesting) }}
       {{ form_errors(editForm._nesting) }}
       </dd>
       {% if editForm._nesting.vars.help is not empty %}
       <dd class="form-container-info">
       <i class="icon-link info tooltipped" aria-label="{{editForm._nesting.vars.help}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'question'} only %}</i>
       </dd>
       {% endif %}
   {% endif %}

   {% for field in editForm.fields %}
       <dt class="form-container-label">{{ form_label(field) }}</dt>
       <dd class="form-container-field">
       {{ form_widget(field) }}
       {{ form_errors(field) }}
       </dd>
       {% if field.vars.help is not empty %}
       <dd class="form-container-info">
       <i class="icon-link info tooltipped" aria-label="{{field.vars.help}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'question'} only %}</i>
       </dd>
       {% endif %}
   {% endfor %}
   <dt class="form-container-label form-container-spacer"></dt>
   <dd class="form-container-buttons">
      {% for field in editForm.buttons %}
          {{ form_widget(field) }}
      {% endfor %}
      
		{% if cancel is defined %}
			{% if cancel is same as(true) %}
				<button class="link-button" type="reset">Reset</button>
			{% else %}
				<a class="link-button" href="{{ cancel }}" title="">Cancel</a>
			{% endif %}
		{% endif %}
		{% if cancel_tab is defined %}
			<label class="link-button" for="{{ cancel_tab }}" title="">Cancel</label>
		{% endif %}
   </dd>
</dl>

{{ form_end(editForm) }}