<form action="{{ path('update_node',{hierarchySlug: hierarchy.slug, keyId:key.id, nodeId: node.id}) }}" method="post" accept-charset="utf-8">
	{% if then is defined %}
	<input type="hidden" name="_then" value="{{then}}">
	{% endif %}

	

	<dl class="form-container">
		{% if not validation.isValid??true %}
			<dt class="form-container-label form-container-spacer">
			</dt>
			<dd class="form-container-field">
	       	{% include 'hierarchy/partials/validation_errors.html.twig' with {validation} only %}
	    	</dd>
		{% endif %}

		{% for field in key.fields %}
        <dt class="form-container-label">
        <label class="form-label" for="field_{{field.id}}">{{field.label.singular}}</label>
        </dt>
        <dd class="form-container-field">
        {{ block('field', 'hierarchy/types/'~ field.templateName ~'.html.twig') }}
    	</dd>
    	<dd class="form-container-info">
        <a class="icon-link" href="{{ path('show_node_field',{hierarchySlug: hierarchy.slug, keyId:key.id, nodeId: node.id, fieldId: field.id}) }}" title="" target="_blank">🡕</a>
    	</dd>

    	{% if field.label.description %}
    	<dd class="form-container-info">
	        <i class="icon-link info" title="{{field.label.description}}" target="_blank">i</i>
    	</dd>
    	{% endif %}

    	{% endfor %}

	<dt class="form-container-label form-container-spacer"></dt>
	<dd class="form-container-buttons">
	{% if force_then??false %}
		<button class="form-button primary">Save Changes</button>
	{% else %}
		<button class="form-button primary">Update</button>
		<button class="form-button" name="_then" value="show">Update and back</button>
	{% endif %}
	{% if cancel is defined %}
		{% if cancel is same as(true) %}
			<button class="link-button" type="reset">Reset</button>
		{% else %}
			<a class="link-button" href="{{ cancel }}" title="">Cancel</a>
		{% endif %}
	{% endif %}
	</dd>
    </dl>
</form>