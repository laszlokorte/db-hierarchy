{% if not validation.isValid %}
<div class="form-error-container">
	<h3 class="form-error-title">
		{% if validation.nodeId %}
			{{ key.label.singular }} could not be saved.
		{% else %}
			{{ key.label.singular }} could not be created.
		{% endif %}
	</h3>
	<dl class="error-list">
		{% for fieldId in validation.errorFields %}
		    <dt class="error-list-label"><label class="form-label" for="field_{{fieldId}}">
		    	{% if fieldId == '_scope' %}
	    			{{key.scopeKey.label.singular}}
	    		{% elseif fieldId == '_parent' %}
	    			{{key.label.singular}}
	    		{% elseif fieldId == '_order' %}
	    			{{key.orderColumnName}}
	    		{% elseif fieldId == '_blocking' %}
	    			Blocking items
	    		{% else %}
	    			{{key.field(fieldId).label.singular}}
	    		{% endif %}
		    </label></dt>
		    <dd class="error-list-item">
		    <ul class="inline-list">
		    	{% for error in validation.fieldErrors(fieldId) %}
			   <li> {{error}}</li>
				{% endfor %}
		    </ul>
			</dd>
		{% endfor %}
	</dl>
</div>
{% endif %}