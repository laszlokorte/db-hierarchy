<nav class="tab-nav">
	<ul class="tab-list">
		<li class="tab-list-item"><a class="{{html_classes('tab-link', {'state-active': active=='show'})}}" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId:node.id}) }}" title="">Overview</a></li>
		<li class="tab-list-item"><a class="{{html_classes('tab-link', {'state-active': active=='edit'})}}" href="{{ path('edit_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId:node.id}) }}" title="">Edit</a></li>
		{% if key.nested %}
		<li class="tab-list-item"><a class="{{html_classes('tab-link', {'state-active': active=='move'})}}" href="{{ path('ask_move_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId:node.id}) }}" title="">Move</a></li>
		{% endif %}
		{% if key.ordered %}
		<li class="tab-list-item"><a class="{{html_classes('tab-link', {'state-active': active=='order'})}}" href="{{ path('ask_order_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId:node.id}) }}" title="">Reorder</a></li>
		{% endif %}
		<li class="tab-list-item"><a class="{{html_classes('tab-link', {'state-active': active=='delete'})}}" href="{{ path('ask_delete_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId:node.id}) }}" title="">Delete</a></li>


		{% if key.nestedKeys %}
			<li class="tab-list-item label" style="margin-left: auto;">
				<span class="tab-label">Children:</span>
			</li>
			{% for ck in key.nestedKeys %}
				<li class="tab-list-item"><a class="{{html_classes('tab-link', {'state-active': childKey is defined and ck.id == childKey.id})}}" href="{{ path('list_child_nodes', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId:node.id, childKeyId: ck.id}) }}" title="">
				{{ck.label.string(ck.isSingleton)}}
				</a></li>
			{% endfor %}
		{% endif %}
	</ul>

</nav>
