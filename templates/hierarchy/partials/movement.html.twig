<form action="{{ path('move_node', {hierarchySlug: hierarchy.slug, keyId: node.key, nodeId: node.id}) }}" method="post" accept-charset="utf-8">

    <dl class="form-container">
        {% if not validation.isValid??true %}
            <dt class="form-container-label form-container-spacer">
            </dt>
            <dd class="form-container-field">
            {% include 'hierarchy/partials/validation_errors.html.twig' with {validation} only %}
            </dd>
        {% endif %}
        <dt class="form-container-label"><label class="form-label" for="target_scope-parent">Move To</label></dt>
        <dd class="form-container-field">
            <select class="form-select" id="target_scope-parent" name="target_scope-parent">
            {% if not key.scoped %}
                {% set selected = (null==node.scope and null==node.parent) %}
                <option value="/">
                Root
                {% if selected %}
                    (current)
                {% endif %}
                </option>
                {% if selected %}
                    <option disabled>{%- for _ in range(0, 1) -%}
                    {{ '&nbsp;&nbsp;&nbsp;'|raw }}
                {%- endfor -%}{{key.summarize(node)}} (self)</option>
                {% endif %}

                {% for scope in moveTargets.getScopes(key.id) %}
                    {{ _self.walkTree(hierarchy, key.id, node, key.id, moveTargets, null, null) }}
                {% endfor %}
            {% else %}
                {% for scope in moveTargets.getScopes(key.scopeKey.id) %}
                    {{ _self.walkTree(hierarchy, key.id, node, key.scopeKey.id, moveTargets, scope, null) }}
                {% endfor %}
            {% endif %}
            </select>
        </dd>
        <dt class="form-container-label form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <button class="form-button primary">Move</button>
        </dd>
    </dl>
</form>

{% macro walkTree(hierarchy, keyId, node, currentKey, h, scope, parent, depth = 0) %}
    {% for n in h.getNodes(currentKey, scope, parent) %}
        {% if keyId == currentKey %}
            {% set selected = (scope==node.scope and n.id==node.parent) %}
        {% else %}
            {% set selected = (n.id==node.scope and null==node.parent) %}
        {% endif %}
        <option {%- if selected %} selected="selected"{% endif %} value="
            {%- if keyId == currentKey %}{{scope}}/{{n.id}}{% else %}{{n.id}}/{% endif -%}
        ">
        {%- for _ in range(0, depth) -%}
            {{ '&nbsp;&nbsp;&nbsp;'|raw }}
        {%- endfor -%}{{hierarchy.getKey(currentKey).summarize(n)}}
        {% if selected %}
            (current)
        {% endif %}
        </option>
        {% if selected %}
            <option disabled>{%- for _ in range(0, depth+1) -%}
            {{ '&nbsp;&nbsp;&nbsp;'|raw }}
        {%- endfor -%}{{hierarchy.getKey(currentKey).summarize(n)}} (self)</option>
        {% endif %}
        {% for childKey in h.getRootKeys %}
            {% if childKey == currentKey %}
                {{ _self.walkTree(hierarchy, keyId, node, childKey, h, n.scope, n.id, depth + 1) }}
            {% else %}
                {{ _self.walkTree(hierarchy, keyId, node, childKey, h, n.id, null, depth+1) }}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endmacro %}