<form action="{{ path('move_node', {key: node.key, id: node.id}) }}" method="post" accept-charset="utf-8">
    <select name="target_scope-parent">
        {% for rootKey in moveTargets.getRootKeys %}
            {{ _self.walkTree(rootKey, moveTargets, null, null) }}
        {% endfor %}
    </select>
    <button name="move">Move</button>
</form>

{% macro walkTree(keyId, h, scope, parent, depth = 0) %}
    {% for node in h.getNodes(keyId, scope, parent) %}
        <option>
        {%- for _ in range(0, depth)|filter(i => i>0) -%}
            {{ '&nbsp;&nbsp;&nbsp;'|raw }}
        {%- endfor -%}<a href="{{ path('show_node', {key:keyId, id: node._id}) }}">{{keyId}}-{{node._id}}</a>
        </option>
        {% for childKey in h.getRootKeys %}
            {% if childKey == keyId %}
                {{ _self.walkTree(childKey, h, node._scope, node._id, depth+1) }}
            {% else %}
                {{ _self.walkTree(childKey, h, node._id, null, depth+1) }}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endmacro %}