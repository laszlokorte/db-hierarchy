<form action="{{ path('move_node', {key: node.key, id: node.id}) }}" method="post" accept-charset="utf-8">
    <select name="target_scope-parent">
    {% if not key.scoped %}
        <option value="/">Root</option>
    {% endif %}
        {% for rootKey in moveTargets.getRootKeys %}
            {{ _self.walkTree(key.id, node, rootKey, moveTargets, null, null) }}
        {% endfor %}
    </select>
    <button name="move">Move</button>
</form>

{% macro walkTree(keyId, node, currentKey, h, scope, parent, depth = 0) %}
    {% for n in h.getNodes(currentKey, scope, parent) %}
        {% if keyId == currentKey %}
            {% set selected = (scope==node.scope and n._id==node.parent) %}
        {% else %}
            {% set selected = (n._id==node.scope and null==node.parent) %}
        {% endif %}
        <option {%- if selected %} selected="selected"{% endif %} value="
            {%- if keyId == currentKey %}{{scope}}/{{n._id}}{% else %}{{n._id}}/{% endif -%}
        ">
        {%- for _ in range(0, depth) -%}
            {{ '&nbsp;&nbsp;&nbsp;'|raw }}
        {%- endfor -%}{{currentKey}}-{{n._id}}
        {% if selected %}
            (current)
        {% endif %}
        </option>
        {% for childKey in h.getRootKeys %}
            {% if childKey == currentKey %}
                {{ _self.walkTree(keyId, node, childKey, h, n._scope, n._id, depth+1) }}
            {% else %}
                {{ _self.walkTree(keyId, node, childKey, h, n._id, null, depth+1) }}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endmacro %}