{% set sortedTabs = tabs|keys|sort((a,b) => tabs[a].default|default(false) <=> tabs[b].default|default(false)) %}
{% set defaultTabId = "radio_tab_"~groupId~"_" ~sortedTabs|last   %}
<div class="tab-container dense">
    {% for tabIndex in sortedTabs %}
    <input type="radio" class="tab-container-radio" id="radio_tab_{{groupId}}_{{tabIndex}}" name="radio_tab_{{groupId}}" value="{{tabIndex}}">
    <div class="{{ html_classes('tab-container-content', tabs[tabIndex].activeClasses|default([])) }}">

        <ul class="quicktab-list">
            {% for otherTabIndex, otherTab in tabs %}
            <li class="quicktab-list-item"><label for="radio_tab_{{groupId}}_{{otherTabIndex}}" class="{{html_classes('quicktab-link', {'state-active': tabIndex == otherTabIndex}, otherTabIndex == tabIndex ? otherTab.activeClasses|default([]) : otherTab.inactiveClasses|default([]))}}">
            {{ otherTab.label }}
            </label></li>
            {% endfor %}

            {% if block('head') is defined %}
            {{ block('head') }}
            {% endif %}
        </ul>

        {% if block('tab_' ~ tabIndex) is defined %}
        {{ block('tab_' ~ tabIndex) }}
        {% endif %}
    </div>
    {% endfor %}
</div>