<form action="{{ path('create_node',{key: key.id}) }}" method="post" accept-charset="utf-8">
	{% if then is defined %}
	<input type="hidden" name="_then" value="{{then}}">
	{% endif %}

	{% if parent is defined %}
	{% if parent.key == key.id %}
        <input type="hidden" name="scope" value="{{ parent.scope }}">
        <input type="hidden" name="parent" value="{{ parent.self.id }}">
    {% else %}
        <input type="hidden" name="scope" value="{{ parent.self.id }}">
    {% endif %}
	{% endif %}
	
	<dl class="form-container">
		{% for field in key.fields %}
        <dt class="form-container-label">
        <label class="form-label" for="field_{{field.id}}">{{field.label.singular}}</label>
        </dt>
        <dd class="form-container-field">
        <input class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}]">
    	</dd>
    	{% endfor %}

	<dt class="form-container-spacer"></dt>
	<dd class="form-container-buttons"><button class="form-button">Create</button></dd>
    </dl>
</form>