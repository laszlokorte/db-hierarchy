<form action="{{ path('create_node',{hierarchySlug: hierarchy.slug, keyId: key.id}) }}" method="post" accept-charset="utf-8">
	{% if then is defined %}
	<input type="hidden" name="_then" value="{{then}}">
	{% endif %}

	{% if parent is defined %}
	{% if parent.key == key.id %}
        <input type="hidden" name="scope" value="{{ parent.scope }}">
        <input type="hidden" name="parent" value="{{ parent.id }}">
    {% else %}
        <input type="hidden" name="scope" value="{{ parent.id }}">
    {% endif %}
	{% endif %}

	
	<dl class="form-container">

		{% if parent is not defined and key.isScoped %}
		<dt class="form-container-label">
        <label class="form-label" for="scope">{{key.scopeKey.label.singular}}</label>
        </dt>
        <dd class="form-container-field">
        <input type="hidden" name="scope" value="">
    	<input 
    data-label-singular="{{ key.scopeKey.label.singular }}" 
    data-label-plural="{{ key.scopeKey.label.plural }}" 
    data-new-url="{{ path('new_root_node', {hierarchySlug: hierarchy.slug, keyId: key.scopeKey.id}) }}" 

    required="required" data-explicit="false" data-reference-url="{{ path('list_all_nodes', {hierarchySlug: hierarchy.slug, keyId: key.scopeKey.id}) }}" class="form-field" type="text" id="scope" name="scope" value="" placeholder="{{key.scopeKey.label.singular}} ID" data-style="expanded" data-expand-limit="10">
    	</dd>
		{% endif %}
		{% if parent is not defined and key.isReflexive %}
		<dt class="form-container-label">
        <label class="form-label" for="parent">Parent {{key.label.singular}}</label>
        </dt>
        <dd class="form-container-field">
        <input type="hidden" name="parent" value="">
    	<input 
    data-label-singular="{{ key.label.singular }}" 
    data-label-plural="{{ key.label.plural }}" 
    data-new-url="{{ path('new_root_node', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" 

     data-explicit="false" data-reference-url="{{ path('list_all_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" class="form-field" type="text" id="parent" name="parent" value="" placeholder="{{key.label.singular}} ID" data-style="expanded" data-expand-limit="10">
    	</dd>
		{% endif %}
		{% for field in key.fields %}
        <dt class="form-container-label">
        <label class="form-label" for="field_{{field.id}}">{{field.label.singular}}</label>
        </dt>
        <dd class="form-container-field">
        {{ block('field', 'hierarchy/types/'~ field.templateName ~'.html.twig') }}
    	</dd>

    	{% if field.label.description %}
	    	<dd class="form-container-info">
	        <i class="icon-link info" title="{{field.label.description}}" target="_blank">i</i>
	    	</dd>
    	{% endif %}
    	{% endfor %}

	<dt class="form-container-label form-container-spacer"></dt>
	<dd class="form-container-buttons">
	{% if force_then|default(false) %}
		<button class="form-button primary required">Confirm</button>
	{% else %}
		<button class="form-button primary" name="_then" value="new">Create and show</button>
		<button class="form-button">Create (stay here)</button>
	{% endif %}
	{% if cancel is defined %}
		{% if cancel is same as(true) %}
			<button class="link-button" type="reset">Reset</button>
		{% else %}
			<a class="link-button" href="{{ cancel }}" title="">Cancel</a>
		{% endif %}
	{% endif %}
	{% if cancel_tab is defined %}
		<label class="link-button" for="{{ cancel_tab }}" title="">Cancel</label>
	{% endif %}
	</dd>
    </dl>
</form>