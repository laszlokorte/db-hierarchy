{% extends 'hierarchy/base.html.twig' %}

{% macro walkTree(key, h, scope, parent) %}
    <ul>
        {% for node in h.getNodes(key.id, scope, parent) %}
            <li>
            {% if key.isNested %}
            <span class="dragger" draggable="true" ondragstart="this.classList.add('state-dragging')" ondragend="this.classList.remove('state-dragging')" ondragover="this.classList.add('state-over');event.preventDefault()" ondragleave="this.classList.remove('state-over')" ondrop="this.classList.remove('state-over');"></span>
            {% endif %}
            <a href="{{ path('show_node', {key:key.id, id: node._id}) }}" title="">{{key.label.singular}}-{{node._id}}</a>
            {% for childKey in key.getNestedKeys %}
                {% if childKey.id == key.id %}
                    {{ _self.walkTree(childKey, h, node._scope, node._id) }}
                {% else %}
                    {{ _self.walkTree(childKey, h, node._id) }}
                {% endif %}
            {% endfor %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block html_title -%}
    Tree - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {trailing: 'Tree'} only %}

<h1>Tree</h1>

{% for key in rootKeys %}
    <h3>{{ key.label.plural }}</h3>
    
    {{ _self.walkTree(key, hierarchy) }}
{% endfor %}

{% endblock %}