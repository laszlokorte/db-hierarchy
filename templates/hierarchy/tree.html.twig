{% extends 'hierarchy/base.html.twig' %}

{% macro walkTree(nodes) %}
    {% if nodes|length %}
    <ul style="border: 1px solid black;">
        {% for node in nodes %}
            {% if node.id is not null %}
                <li>
                {% if node.id is not null %}
                <a href="{{path('show_node',{key:node.hierarchyKey, id: node.id})}}" title="">{{ node.hierarchyKey }}-{{ node.id }}</a>
                
                {{ _self.walkTree(node.children) }}
                {% endif %}

                    <ul>
                        {% for c in node.children %}
                    {% if c.id is not null %}
                    <li>
                    <a href="{{path('show_node',{key:c.hierarchyKey, id: c.id})}}" title="">{{ c.hierarchyKey }}-{{ c.id }}</a>
                    </li>
                    {% endif %}
                {% endfor %}
                    </ul>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
    {% endif %}
{% endmacro %}

{% block html_title -%}
    Tree - {{ parent() }}
{%- endblock %}


{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {trailing: 'Tree'} only %}

<h1>Tree</h1>

{% for node in treeNodes %}
    <h3>{{ node.key.label.plural }}</h3>
    <a href="{{ path('new_root_node', {key: node.key.id}) }}" title="">New</a> | 
    <a href="{{ path('list_root_nodes', {key: node.key.id}) }}" title="">List</a>

    {% if node.children|length %}
        {{ _self.walkTree(node.getChildren()) }}
    {% else %}
        <p>
            none
        </p>
    {% endif %}
    <hr>
{% endfor %}


{% endblock %}