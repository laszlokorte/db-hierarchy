{% extends 'hierarchy/base.html.twig' %}

{% macro walkTree(nodes) %}
    {% if nodes|length %}
    <ul>
        {% for node in nodes %}
            {% if node.id is not null %}
            <li>
            <a href="{{path('show_node',{key:node.hierarchyKey, id: node.id})}}" title="">{{ node.hierarchyKey }}-{{ node.id }}</a>
            {{ _self.walkTree(node.children) }}
            </li>
            {% else %}
            {{ _self.walkTree(node.children) }}
            {% endif %}
        {% endfor %}
    </ul>
    {% endif %}
{% endmacro %}

{% block html_title -%}
    Tree - {{ parent() }}
{%- endblock %}


{% block area_main %}

{% include 'hierarchy/partials/breadcrump_.html.twig' with {trailing: 'Tree'} only %}

<h1>Tree</h1>

{% for node in tree.nodes %}
    <h3>{{ node.hierarchyKey|capitalize }}</h3>
    <a href="{{ path('new_root_node', {key: node.hierarchyKey}) }}" title="">New</a> | 
    <a href="{{ path('list_root_nodes', {key: node.hierarchyKey}) }}" title="">List</a>

    {% if node.isNotEmpty %}
        {{ _self.walkTree(node.getChildren()) }}
    {% else %}
        <p>
            none
        </p>
    {% endif %}
    <hr>
{% endfor %}


{% endblock %}