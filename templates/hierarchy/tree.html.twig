{% extends 'hierarchy/base.html.twig' %}

{% macro walkTree(hierarchy, key, h, scope, parent) %}
    {% if h.getNodes(key.id, scope, parent) %}
    <ul class="block-list"
    >
        {% if scope and not parent %}
            <li style="background-color: transparent;"><small style="font-weight: bold;">{{key.label.string(key.isSingleton)}}</small></li>
        {% endif %}
        {% for node in h.getNodes(key.id, scope, parent) %}
            <li data-key="{{key.id}}" data-parent="{{node.id}}" data-scope="{{scope}}"
    ondragover="if((event.dataTransfer.getData('scope')==this.dataset.key||event.dataTransfer.getData('key')==this.dataset.key)) {this.classList.add('state-over');event.preventDefault();event.stopPropagation()}" 
    ondragleave="this.classList.remove('state-over')" 
    ondrop="
    if(event.dataTransfer.getData('move-url') && (event.dataTransfer.getData('scope')==this.dataset.key||event.dataTransfer.getData('key')==this.dataset.key)) {
        event.stopPropagation()
        this.classList.remove('state-over');document.body.classList.remove('state-dragging');document.querySelectorAll('.drag-target-large,.state-over').forEach(e=>e.classList.remove('drag-target-large','state-over'));
            event.stopPropagation();
            let fd = new FormData();
            if(event.dataTransfer.getData('key')==this.dataset.key) {
                fd.append('target_scope-parent', this.dataset.scope+'/'+this.dataset.parent);
            } else {
                fd.append('target_scope-parent', this.dataset.parent+'/');
            }
            fd.append('_then', 'tree');
            document.querySelectorAll('[draggable]').forEach((e) => e.draggable=false)
            fetch(event.dataTransfer.getData('move-url'), {
              method: 'POST',
              body: fd
            }).then((r) => {
                if(r.url != window.location.href) {
                window.location.href = r.url
            } else {
                window.location.reload()
            }})
        }
        ">
            <div style="display: flex; gap: 0.5ch">
                {% if key.isOrdered %}
                {% include 'hierarchy/partials/dragger.html.twig' with {hierarchy: hierarchy,then:'tree',keyId:key.id, nestId: (scope??'-')~"*"~(parent??'-'), nodeId: node.id, order:node.order} %}
                {% endif %}
                {% if key.isNested %}
                <span class="dragger" 
                data-url="{{ path('move_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId: node.id}) }}"
                {% if key.isScoped %}
                data-scope="{{key.scopeKey.id}}"
                {% endif %}
                {% if key.isReflexive %}
                data-key="{{key.id}}"
                {% endif %}
                draggable="true" 
                ondragstart="
                this.parentNode.parentNode.classList.add('state-dragging');
                event.dataTransfer.setData('move-url', this.dataset.url);event.dataTransfer.setData('scope', this.dataset.scope);event.dataTransfer.setData('key', this.dataset.key);this.classList.add('state-dragging');document.querySelectorAll('[data-key=\''+this.dataset.scope+'\'], [data-key=\''+this.dataset.key+'\']').forEach(e=>e.classList.add('drag-target-large'));document.body.classList.add('state-dragging')" 
                ondragend="
                this.parentNode.parentNode.classList.remove('state-dragging');
                this.classList.remove('state-dragging');document.querySelectorAll('.drag-target-large,.state-over').forEach(e=>e.classList.remove('drag-target-large','state-over'));document.body.classList.remove('state-dragging')
                "
                >
                    {% include 'hierarchy/partials/icon.html.twig' with {icon: 'workflow'} only %}

                </span>
                {% endif %}
                <a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId:key.id, nodeId: node.id}) }}" title="">{{key.summarize(node)}}</a>
            </div>
            
            {% for childKey in key.getNestedKeys %}
                {% if childKey.id == key.id %}
                    {{ _self.walkTree(hierarchy, childKey, h, node.scope, node.id) }}
                {% else %}
                    {{ _self.walkTree(hierarchy, childKey, h, node.id) }}
                {% endif %}
            {% endfor %}
            </li>
        {% endfor %}
    </ul>
    {% endif %}
{% endmacro %}

{% block html_title -%}
    Tree - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,trailing: 'Tree'} only %}

<h1>Tree</h1>

{% for key in hierarchy.rootKeys %}
    <h3><a href="{{ path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: key.id}) }}" title="">{{ key.label.string(key.isSingleton) }}</a></h3>
    
    {% if not hierarchyNodes.hasNodes(key.id) %}
        <p>
            None
        </p>
    {% else %}
        {% if key.isReflexive %}
            <span data-key="{{key.id}}"
    ondragover="if(event.dataTransfer.getData('key')==this.dataset.key) {this.classList.add('state-over');event.preventDefault();event.stopPropagation()}" 
    ondragleave="this.classList.remove('state-over')"
    ondrop="
    if(event.dataTransfer.getData('move-url') && 'undefined'===event.dataTransfer.getData('scope')) {
        event.stopPropagation();
        this.classList.remove('state-over');document.body.classList.remove('state-dragging');document.querySelectorAll('.drag-target-large,.state-over').forEach(e=>e.classList.remove('drag-target-large','state-over'));
            event.stopPropagation();
            let fd = new FormData();
            fd.append('target_scope-parent', '/');
            fd.append('_then', 'tree');
            document.querySelectorAll('[draggable]').forEach((e) => e.draggable=false);
            fetch(event.dataTransfer.getData('move-url'), {
              method: 'POST',
              body: fd
            }).then((r) => {
                if(r.url != window.location.href) {
                window.location.href = r.url
            } else {
                window.location.reload()
            }})
        }
        "
    >Root</span>
        {% endif %}
        {{ _self.walkTree(hierarchy, key, hierarchyNodes) }}
    {% endif %}
{% else %}
    <p>No Data</p>
{% endfor %}

{% endblock %}