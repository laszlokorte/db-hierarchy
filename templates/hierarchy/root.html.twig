{% extends 'hierarchy/base.html.twig' %}
{% block html_title -%}
    Overview - {{ parent() }}
{%- endblock %}
{% block area_main %}

{% for rootKey in rootKeys %}
    <h2>{{ rootKey.label.plural }}</h2>

    {% include 'hierarchy/partials/form_new.html.twig' with {key: rootKey, then: 'root'} only %}

    {% include 'hierarchy/partials/table.html.twig' with {key: rootKey, nodeCollection: rootNodes.nodesFor(rootKey.id), then: 'root', listLink: true} only %}
{% endfor %}
{% endblock %}