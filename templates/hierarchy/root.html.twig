{% extends 'hierarchy/base.html.twig' %}
{% block html_title -%}
    Overview - {{ parent() }}
{%- endblock %}
{% block area_main %}


{% for rootKey in rootKeys %}
    <h2>{{ rootKey|capitalize }}s</h2>

    {% include 'hierarchy/partials/form_new.html.twig' with {fields: allFields[rootKey], key: rootKey, then: 'root'} only %}

    {% include 'hierarchy/partials/table.html.twig' with {fields: allFields[rootKey], nodes: rootNodes[rootKey], key: rootKey, then: 'root', listLink: true} only %}
{% endfor %}
{% endblock %}