{% extends 'hierarchy/base.html.twig' %}
{% block html_title -%}
    Overview - {{ parent() }}
{%- endblock %}
{% block area_main %}

<h1>
<span>
{{ hierarchy.label.singular }} Dashboard
</span>
</h1>

{% if hierarchy.label.description is not empty %}
<p>
    {{ hierarchy.label.description }}
</p>
{% endif %}

{% for rootKey in hierarchy.rootKeys %}
    {% set nodes = rootNodes.nodesFor(rootKey.id) %}
    <section>
        <h2>
        <span>
          {%- include 'hierarchy/partials/icon.html.twig' with {icon: rootKey.label.icon, prefix: true} only -%}
        {{ rootKey.label.string(rootKey.isSingleton) }}
        </span>
        {%- if rootKey.label.description is not empty -%}
        <i class="icon-link info tooltipped" aria-label="{{rootKey.label.description}}" target="_blank">
            {% include 'hierarchy/partials/icon.html.twig' with {icon: 'question'} only %}
        </i>
        {% endif %}
        </h2>

{% if rootKey.isSingleton %}
{% for nodeId in nodes.ids %}

  {% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: rootKey.id~'-'~nodeId, tabs: [
    {label: rootKey.label.empty, activeClasses: 'need-confirmation'},
    {label: rootKey.label.plural, default: true},
    {label: 'Edit', activeClasses: 'need-confirmation'},
  ]} %}
  {% block head %}
    <li class="quicktab-list-item">
        <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: rootKey.id, nodeId: nodeId}) }}" title="">Details&hellip;</a>
    </li>
  {% endblock %}

  {% block tab_0 %}
      
    {% include 'hierarchy/partials/form_delete.html.twig' with {hierarchy, deletionForm: deletionForm(hierarchy, rootKey.id, nodeId), cancel_tab: defaultTabId|default(null),key: rootKey} only %}

  {% endblock %}

  {% block tab_1 %}
      

    {% include 'hierarchy/partials/fields.html.twig' with {hierarchy,key:rootKey, node: nodes.getNode(nodeId)} only %}
  {% endblock %}

  {% block tab_2 %}
      
    {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, editForm: editForm(hierarchy, nodes.getNode(nodeId)), force_then: true, then: 'root', cancel: true, cancel_tab: defaultTabId|default(null)} only %}
  {% endblock %}

{% endembed %}

{% else %}
    {% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: rootKey.id, tabs: [
    {label: rootKey.label.empty, default: true},
    {label: rootKey.label.plural, activeClasses: 'need-confirmation'},
  ]} %}
      {% block tab_0 %}
      {% endblock %}
      {% block tab_1 %}
        {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'root', force_then: true, cancel_tab: defaultTabId|default(null), creationForm: creationForm(hierarchy, rootKey.id)} only %}
      {% endblock %}
    {% endembed %}
{% endfor %}


        {% else %}
         {% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: rootKey.id, tabs: [
            {label: 'List', default: true},
            {label: 'New'},
          ]} %}
              {% block tab_0 %}
                {% include 'hierarchy/partials/table.html.twig' with {hierarchy,key: rootKey, nodeCollection: nodes, then: 'parent', listLink: true} only %}
              {% endblock %}
              {% block tab_1 %}
                    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'parent', creationForm: creationForm(hierarchy, rootKey.id)} only %}
              {% endblock %}
            {% endembed %}
        {% endif %}
    </section>
{% endfor %}
{% endblock %}