{% extends 'hierarchy/base.html.twig' %}
{% block html_title -%}
    Overview - {{ parent() }}
{%- endblock %}
{% block area_main %}

<h1>{{ hierarchy.label.singular }} Dashboard</h1>

{% if hierarchy.label.description is not empty %}
<p>
    {{ hierarchy.label.description }}
</p>
{% endif %}

{% for rootKey in hierarchy.rootKeys %}
    <section>
        <h2>
        {{ rootKey.label.string(rootKey.isSingleton) }}
        {%- if rootKey.label.description is not empty -%}
        <i class="icon-link info" aria-label="{{rootKey.label.description}}" target="_blank">
            {% include 'hierarchy/partials/icon.html.twig' with {icon: 'info'} only %}
        </i>
        {% endif %}
        </h2>

        {% if rootKey.isSingleton %}

{% for nodeId in rootNodes.nodesFor(rootKey.id).ids %}

  {% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: rootKey.id~'-'~nodeId, tabs: [
    {label: rootKey.label.empty, activeClasses: 'need-confirmation'},
    {label: rootKey.label.plural, default: true},
    {label: 'Edit', activeClasses: 'need-confirmation'},
  ]} %}
  {% block head %}
    <li class="quicktab-list-item">
        <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: rootKey.id, nodeId: nodeId}) }}" title="">Details&hellip;</a>
    </li>
  {% endblock %}

  {% block tab_0 %}
      <p>
            Are you sure?
        </p>

        <form action="{{ path('delete_node',{hierarchySlug: hierarchy.slug, keyId: rootKey.id, nodeId:nodeId}) }}" method="post" accept-charset="utf-8">
        <dl class="form-container">
            <dt class="form-container-spacer"></dt>
            <dd class="form-container-buttons">
                <input type="hidden" name="_then" value="parent">
                <button name="soft" class="action-button danger">Yes, Delete!</button>
                <label class="link-button" for="{{defaultTabId|default(null)}}" class="quicktab-link">
            Cancel
            </label>
            </dd>
        </dl>
        </form>
  {% endblock %}

  {% block tab_1 %}
      

    {% include 'hierarchy/partials/fields.html.twig' with {hierarchy,key:rootKey, node: rootNodes.nodesFor(rootKey.id).getNode(nodeId)} only %}
  {% endblock %}

  {% block tab_2 %}
      
    {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, update: rootNodes.nodesFor(rootKey.id).getNode(nodeId).newUpdate, force_then: true, then: 'root', cancel: true, cancel_tab: defaultTabId|default(null)} only %}
  {% endblock %}

{% endembed %}

{% else %}
    {% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: rootKey.id, tabs: [
    {label: rootKey.label.empty, default: true},
    {label: rootKey.label.plural, activeClasses: 'need-confirmation'},
  ]} %}
      {% block tab_0 %}
      {% endblock %}
      {% block tab_1 %}
        {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'root', force_then: true, cancel_tab: defaultTabId|default(null), creation: rootKey.newCreation()} only %}
      {% endblock %}
    {% endembed %}
{% endfor %}


        {% else %}
         {% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: rootKey.id, tabs: [
            {label: 'List', default: true},
            {label: 'New'},
          ]} %}
              {% block tab_0 %}
                {% include 'hierarchy/partials/table.html.twig' with {hierarchy,key: rootKey, nodeCollection: rootNodes.nodesFor(rootKey.id), then: 'parent', listLink: true} only %}
              {% endblock %}
              {% block tab_1 %}
                    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'parent', creation: rootKey.newCreation()} only %}
              {% endblock %}
            {% endembed %}
        {% endif %}
    </section>
{% endfor %}
{% endblock %}