{% extends 'hierarchy/base.html.twig' %}
{% block html_title -%}
    Overview - {{ parent() }}
{%- endblock %}
{% block area_main %}

<h1>Dashboard</h1>

{% for rootKey in rootKeys %}
    <section>
        <h2>{{ rootKey.label.plural }}</h2>

        {% include 'hierarchy/partials/table.html.twig' with {key: rootKey, nodeCollection: rootNodes.nodesFor(rootKey.id), then: 'parent', listLink: true} only %}

         <div class="quickform">
        <h3>New</h3>
            {% include 'hierarchy/partials/form_new.html.twig' with {key: rootKey, then: 'parent'} only %}
        </div>
    </section>
{% endfor %}
{% endblock %}