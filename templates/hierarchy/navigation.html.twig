{% macro walkSubKeys(hierarchy, key) %}
    {% if key.scopeChildKeys(false) %}
    <ul class="block-list small">
        {% for childKey in key.scopeChildKeys(false) %}
        <li>
        <a href="{{ path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: childKey.id}) }}" title="">{{ childKey.label.plural }}</a>
        {{ _self.walkSubKeys(hierarchy, childKey) }}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
{% endmacro %}

<nav class="site-nav">
    <a class="stealth-link" href="{{ path('hierarchy_root', {hierarchySlug: hierarchy.slug}) }}" title="">
        <h1 class="site-title">
        <svg class="site-title-icon" viewBox="-15 -15 158 158" width="100" height="100" preserveAspectRatio="xMinYMid meet">
            {% include 'asset/favicon.svg.twig' with {color: 'currentColor'} only %}
        </svg>
        {{hierarchy.label.singular}}
        </h1>
    </a>
    <ul class="block-list">
        {% for rootKey in hierarchy.rootKeys %}
        <li>
        <a href="{{ path('list_root_nodes', {hierarchySlug: hierarchy.slug, keyId: rootKey.id}) }}" title="">{{ rootKey.label.string(rootKey.isSingleton) }}</a>
        {{ _self.walkSubKeys(hierarchy, rootKey) }}
        </li>
        {% endfor %}
    </ul>

    <ul class="block-list">
        <li><a href="{{ path('hierarchy_tree', {hierarchySlug: hierarchy.slug}) }}">Full Hierarchy</a></li>
    </ul>

    {% if systemHierarchy == hierarchy %}
    <h2 class="site-section-title">System</h2>
    <ul class="block-list">
        <li><a href="{{ path('show_system_installer', {hierarchySlug: systemHierarchy.slug}) }}">Installer</a></li>
        <li><a href="{{ path('show_health', {hierarchySlug: systemHierarchy.slug}) }}">Health check</a></li>
    </ul>
    {% endif %}


    <script>
        if(window.localStorage.getItem('quickform') == 'true') {
            document.body.classList.toggle('show-quickform')
        }
    </script>

    <h2 class="site-section-title">Account</h2>
    <ul class="block-list">
        <li><a href="{{ path('security_logout') }}" title="">Log out</a></li>
    </ul>
</nav>
