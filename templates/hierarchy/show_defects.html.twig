{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Defects  - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {trailing: 'Defects'} only %}

<h1>Hierarchy Defects</h1>

<form action="{{ path('repair_hierarchy_defects') }}" method="post" accept-charset="utf-8">
    <button>Repair all</button>
</form>

<div style="display: grid; grid-template-columns: 1fr 1fr;">
{% for key, kinds in closureDefects %}
    <h2 style="grid-column: 1 / -1">{{ key|capitalize }}</h2>

    {% for kind, defectsOfKind in kinds %}
        <div>
            <h3>{{ kind|capitalize }}</h3>
            <table class="data-table">
                <thead class="data-table-head">
                    <tr class="data-table-head-row">
                        <th class="data-table-head-cell">id</th>
                        <th class="data-table-head-cell">parent_id</th>
                        <th class="data-table-head-cell">child_id</th>
                        <th class="data-table-head-cell">depth</th>
                    </tr>
                </thead>
                <tbody class="data-table-body">
                    {% for def in defectsOfKind %}
                        <tr class="data-table-row">
                            <td class="data-table-cell" align="center">{{ def['id']|default('-') }}</td>
                            <td class="data-table-cell" align="center">{{ def['parent_id'] }}</td>
                            <td class="data-table-cell" align="center">{{ def['child_id'] }}</td>
                            <td class="data-table-cell" align="center">{{ def['depth'] }}</td>
                        </tr>
                    {% else %}
                        <tr class="data-table-empty-row">
                            <td class="data-table-empty-cell" colspan="4">nothing {{ kind }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endfor %}
    
    <div style="grid-column: 1 / -1;">
        <form action="{{ path('repair_hierarchy_key_defects',{key}) }}" method="post" accept-charset="utf-8">
            <button>Repair {{key}} closure</button>
        </form>
    </div>
{% endfor %}
</div>

<h1>Sorting</h1>
<form action="{{ path('normalize_all_order') }}" method="post" accept-charset="utf-8">
    <button>Normalize all order</button>
</form>

<div style="display: grid; grid-template-columns: 1fr 1fr 1fr;">
    
{% for key, orderDefs in orderDefects %}
<div>
    <h2>{{ key }}</h2>
    <table class="data-table">
        <thead class="data-table-head">
            <tr class="data-table-head-row">
                <th class="data-table-head-cell">id</th>
                <th class="data-table-head-cell">stored_order</th>
                <th class="data-table-head-cell">normalized_order</th>
            </tr>
        </thead>
        <tbody class="data-table-body">
            {% for def in orderDefs %}
                <tr class="data-table-row">
                    <td class="data-table-cell" align="center">{{ def['id'] }}</td>
                    <td class="data-table-cell" align="center">{{ def['stored_order'] }}</td>
                    <td class="data-table-cell" align="center">{{ def['normalized_order'] }}</td>
                </tr>
            {% else %}
                <tr class="data-table-empty-row">
                    <td class="data-table-empty-cell" colspan="3">order is normalized</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot class="data-table-footer">
            <tr class="data-table-footer-row">
                <td class="data-table-footer-cell" colspan="3">
                    <form action="{{ path('normalize_key_order',{key}) }}" method="post" accept-charset="utf-8">
                        <button>Normalize {{key}} order</button>
                    </form>
                </td>
            </tr>
        </tfoot>
    </table>
</div>
{% endfor %}

</div>
{% endblock %}