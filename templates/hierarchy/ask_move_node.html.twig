{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Move {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}


{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,key, parentNodes} only %}

<h1><span data-prefix="{{key.label.singular}}">{{ key.summarize(node) }}</span></h1>
{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy: hierarchy,key, node, active: 'move'} only %}

<h2>Move</h2>


{{ form_start(movementForm) }}

{{ form_errors(movementForm) }}

<dl class="form-container">
  <dt class="form-container-label">{{ form_label(movementForm.target) }}</dt>
   <dd class="form-container-field">
   {{ form_widget(movementForm.target) }}
   {{ form_errors(movementForm.target) }}
   </dd>
   {% if movementForm.target.vars.help is not empty %}
   <dd class="form-container-info">
   <i class="icon-link info tooltipped" aria-label="{{movementForm.target.vars.help}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'question'} only %}</i>
   </dd>
   {% endif %}
   <dt class="form-container-label form-container-spacer"></dt>
   <dd class="form-container-buttons">
      {% for field in movementForm.buttons %}
          {{ form_widget(field) }}
      {% endfor %}
   </dd>
</dl>

{{ form_end(movementForm) }}


{% endblock %}