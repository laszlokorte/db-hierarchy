{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Edit {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,key, parentNodes} only %}

<h1><span data-prefix="{{key.label.singular}}">

    {%- include 'hierarchy/partials/icon.html.twig' with {icon: key.label.icon, prefix: true} only -%}
    {{ key.summarize(node) }}</span></h1>

{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy,key, node, active: 'edit'} only %}

<div>
<h2>Edit {{ field.label.singular }}</h2>
</div>
{% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, then: 'edit', editForm} only %}


{% endblock %}
