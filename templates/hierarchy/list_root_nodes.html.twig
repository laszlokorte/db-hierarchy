{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    List {{key.label.plural}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {nodeParents, childKey: key} only %}


<h1>{{key.label.plural}}</h1>

{% include 'hierarchy/partials/sub_tabs.html.twig' with {active: 'list', key} only %}

{% include 'hierarchy/partials/table.html.twig' with {nodeCollection, key, then:'root_list'} only %}

<div class="quickform">
<h3>New</h3>
{% include 'hierarchy/partials/form_new.html.twig' with {key, then:'root_list'} only %}
</div>
{% endblock %}