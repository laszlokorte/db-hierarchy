{% extends 'hierarchy/base.html.twig' %}


{% block html_title -%}
    {{key|capitalize}}s - {{ parent() }}
{%- endblock %}

{% block area_main %}

/ <a href="{{ path('hierarchy_root') }}" title="">Root</a> / {{key|capitalize}}s

<h1>{{key|capitalize}}s</h1>

    <form action="{{ path('create_node',{key: key}) }}" method="post" accept-charset="utf-8">
    	<dl class="form-container">{% for field in fields %}
	        <dt class="form-container-label"><label for="field_{{field}}">{{field|capitalize}}</label></dt>
	        <dd class="form-container-field">
	        <input type="text" id="field_{{field}}" name="field[{{field}}]">
	    {% endfor %}</dd>
        <dt class="form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <button>Create</button>
        </dd>
	    </dl>
    	
    </form>

    <table class="data-table">
        <thead class="data-table-head">
            <tr class="data-table-head-row">
                <th class="data-table-head-cell">id</th>
                {% for field in fields %}
                    <th class="data-table-head-cell">{{ field }}</th>
                {% endfor %}
                <th class="data-table-head-cell" width="50%"></th>
                <th class="data-table-head-cell" align="right">actions</th>
            </tr>
        </thead>
        {% if nodes|length %}
        <tbody class="data-table-body">
            {% for node in nodes %}
                <tr class="data-table-row">
                    <td class="data-table-cell"><a href="{{ path('show_node', {key: key, id: node.id}) }}">{{ node.id }}</a></td>
                    {% for field in fields %}
                        <td class="{{ html_classes('data-table-cell', {'empty': node[field] is empty}) }}">{{ node[field]|join }}</td>
                    {% endfor %}
                    <td></td>
                    <td class="data-table-cell" align="right">
                         <form class="inline-form" action="{{ path('delete_node', {key: key, id: node.id}) }}" method="post" accept-charset="utf-8">
                            <button class="inline-button">X</button>
                        </form>
                        <a href="{{ path('ask_delete_node', {key: key, id: node.id}) }}" title="">Delete</a>

                        <a href="{{ path('edit_node', {key: key, id: node.id}) }}" title="">Edit</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        {% else %}
        <tbody>
            <tr class="data-table-empty-row">
                <td class="data-table-empty-cell" colspan="{{ fields|length + 3 }}">
                empty
                <br>
                <a href="{{ path('new_root_node', {key}) }}" title="">New {{key}}</a>
                </td>
            </tr>
        </tbody>
        {% endif %}
        <tfoot class="data-table-foot">
            <tr class="data-table-foot-row">
                <td class="data-table-foot-cell" colspan="{{ fields|length + 2 }}">
                    <a href="{{ path('list_root_nodes', {key, key}) }}" title="">Show {{key}}s</a>
                </td>
                <td class="data-table-foot-cell" align="right">
                    <a href="{{ path('new_root_node', {key, key}) }}" title="">New {{key|capitalize}}</a>
                </td>
            </tr>
        </tfoot>
    </table>
{% endblock %}