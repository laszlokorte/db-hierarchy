{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    List {{key.label.plural}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,key, parentNodes} only %}


<h1>
<span>
    {%- include 'hierarchy/partials/icon.html.twig' with {icon: key.label.icon, prefix: true} only -%}
{{key.label.string(key.isSingleton and not key.isScoped)}}
</span>
{%- if key.label.description is not empty -%}
<i class="icon-link info tooltipped" aria-label="{{key.label.description}}" target="_blank">{% include 'hierarchy/partials/icon.html.twig' with {icon: 'question'} only %}</i>
{% endif %}
</h1>

{% if key.isSingleton and not key.isScoped %}

{% for nodeId in nodeCollection.ids %}

{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: key.id~'-'~nodeId, tabs: [
{label: key.label.empty, activeClasses: 'need-confirmation'},
{label: key.label.plural, default: true},
{label: 'Edit', activeClasses: 'need-confirmation'},
]} %}
{% block head %}
    <li class="quicktab-list-item">
        <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId: nodeId}) }}" title="">Details&hellip;</a>
    </li>
{% endblock %}
{% block tab_0 %}
    
    {% include 'hierarchy/partials/form_delete.html.twig' with {hierarchy, deletionForm: deletionForm(hierarchy, key.id, nodeId), cancel_tab: defaultTabId|default(null), key} only %}
{% endblock %}
{% block tab_1 %}
    {% include 'hierarchy/partials/fields.html.twig' with {hierarchy,key, node: nodeCollection.getNode(nodeId)} only %}

{% endblock %}
{% block tab_2 %}
    {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, editForm: editForm(hierarchy, nodeCollection.getNode(nodeId)), force_then: true, then: 'list', cancel: true, cancel_tab: defaultTabId|default(null)} only %}
{% endblock %}
{% endembed %}
{% else %}


{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: key.id, tabs: [
{label: key.label.empty, default: true},
{label: key.label.plural, activeClasses: 'need-confirmation'},
]} %}
{% block tab_0 %}
{% endblock %}
{% block tab_1 %}
    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'list', force_then: true, cancel_tab: defaultTabId|default(null), creationForm: creationForm(hierarchy, key.id)} only %}
{% endblock %}
{% endembed %}
{% endfor %}


{% else %}

{% include 'hierarchy/partials/sub_tabs.html.twig' with {hierarchy,active: 'list', key} only %}

{% include 'hierarchy/partials/table.html.twig' with {hierarchy,nodeCollection, key, then:'root_list'} only %}

{% include 'hierarchy/partials/paginator.html.twig' with {hierarchy,nodeCollection, key} only %}

<div class="quickform">
<h3>New</h3>
{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then:'root_list', creationForm: creationForm(hierarchy, key.id)} only %}
</div>
{% endif %}


{% endblock %}