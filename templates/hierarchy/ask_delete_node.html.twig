{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Delete {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}


{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,key, parentNodes} only %}

<h1><span data-prefix="{{key.label.singular}}">

    {%- include 'hierarchy/partials/icon.html.twig' with {icon: key.label.icon, prefix: true} only -%}
    {{ key.summarize(node) }}</span></h1>
{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy: hierarchy,key, node, active: 'delete'} only %}

<h2>Delete</h2>

{% include 'hierarchy/partials/form_delete.html.twig' with {hierarchy, deletion, deletionForm, key} only %}




{% endblock %}
