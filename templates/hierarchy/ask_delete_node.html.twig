{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}


{% include 'hierarchy/partials/breadcrump.html.twig' with {nodeParents, trailing: 'delete'} only %}

<h1>Delete {{ key.label.singular }} {{node.id}}</h1>

<form action="{{ path('delete_node',{key: key.id, id:node.id}) }}" method="post" accept-charset="utf-8">

    <p>
        Are you sure you want to delete this {{ key.label.singular }}?
    </p>

    <dl class="form-container">
        <dt class="form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <button>Delete</button>
            <a href="{{ path('show_node', {key: key.id, id:node.id}) }}" title="cancel">Cancel</a>
        </dd>
    </dl>
</form>
{% endblock %}