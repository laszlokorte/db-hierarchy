{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Delete {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}


{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,key, parentNodes} only %}

<h1><span data-prefix="{{key.label.singular}}">{{ key.summarize(node) }}</span></h1>
{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy: hierarchy,key, node, active: 'delete'} only %}

<h2>Delete</h2>

{% include 'hierarchy/partials/form_delete.html.twig' with {hierarchy, deletion} only %}


{{ form_start(deletionForm) }}

{{ form_errors(deletionForm) }}

<dl class="form-container">
   <dt class="form-container-label form-container-spacer"></dt>
   <dd class="form-container-buttons">
      {% for field in deletionForm.buttons %}
          {{ form_widget(field) }}
      {% endfor %}
      
        <a class="link-button" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: key.id, nodeId:deletion.nodeId}) }}" title="cancel">Cancel</a>
   </dd>
</dl>

{{ form_end(deletionForm) }}

{% endblock %}