{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{ key.label.singular }} {{id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump_.html.twig' with {parentGroups: node.parents, key, id, trailing: 'delete'} only %}

<h1>Delete {{ key.label.singular }} {{id}}</h1>

<form action="{{ path('delete_node',{key: key.id, id:id}) }}" method="post" accept-charset="utf-8">

    <p>
        Are you sure you want to delete this {{ key.label.singular }}?
    </p>

    <dl class="form-container">
        <dt class="form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <button>Delete</button>
            <a href="{{ path('show_node', {key: key.id, id}) }}" title="cancel">Cancel</a>
        </dd>
    </dl>
</form>
{% endblock %}