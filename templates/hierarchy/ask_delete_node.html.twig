{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Delete {{ key.label.singular }} {{node.id}} - {{ parent() }}
{%- endblock %}

{% block area_main %}


{% include 'hierarchy/partials/breadcrump.html.twig' with {key, parentNodes} only %}

<h1>{{ key.label.singular }} {{node.id}}</h1>

{% include 'hierarchy/partials/tabs.html.twig' with {key, node, active: 'delete'} only %}

<h2>Delete</h2>

<form action="{{ path('delete_node',{key: key.id, id:node.id}) }}" method="post" accept-charset="utf-8">
    {% if deletionPlan.willDelete.nodesFor(key.id).count > 1 or deletionPlan.willDelete.getKeys()|length > 1 %}
        <div class="warning-box">
            <h3 style="margin: 0">Warning: This {{ key.label.singular }} has associated child nodes</h3>
            <p>Following nodes will also be deleted:</p>

            <dl class="keyvalue-container">
                {% for key in deletionPlan.willDelete.getKeys() %}
                    <dt class="keyvalue-container-label top">{{schemaRoot.getKey(key).label.plural}}</dt>
                    <dd class="keyvalue-container-field wide">
                        <ul class="inline-list separator">
                            {% for id in deletionPlan.willDelete.getNodesFor(key).getIds() %}
                                <li><a href="{{path('show_node',{key, id})}}">{{schemaRoot.getKey(key).summarize(deletionPlan.willDelete.getNodesFor(key).getNode(id))}}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endfor %}
            </dl>
        </div>
        {% else %}
            <div class="approve-box">This node does not have any child nodes.</div>
        {% endif %}

    {% if not deletionPlan.blockers.isEmpty %}
        <div class="warning-box">
            <h3 style="margin: 0">Node can not be deleted.</h3>

            <p>
                There are one or more references from other nodes to the nodes to be deleted. Please remove these references.
            </p>

            <dl class="keyvalue-container">
                {% for key in deletionPlan.blockers.keys %}
                    <dt class="keyvalue-container-label top">{{schemaRoot.getKey(key).label.plural}}</dt>
                    <dd class="keyvalue-container-field wide">
                        <ul class="inline-list separator">
                            {% for id in deletionPlan.blockers.getNodesFor(key).getIds() %}
                                <li><a href="{{path('show_node',{key, id})}}">{{schemaRoot.getKey(key).summarize(deletionPlan.blockers.getNodesFor(key).getNode(id))}}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endfor %}
            </dl>
        </div>
    {% else %}
            <p>
                Are you sure you want to delete this {{ key.label.singular }}?
            </p>

            <dl class="form-container">
                <dt class="form-container-spacer"></dt>
                <dd class="form-container-buttons">
                    <button class="action-button danger">Yes, Delete!</button>
                    <a class="link-button" href="{{ path('show_node', {key: key.id, id:node.id}) }}" title="cancel">Cancel</a>
                </dd>
            </dl>

    {% endif %}

    
</form>
{% endblock %}