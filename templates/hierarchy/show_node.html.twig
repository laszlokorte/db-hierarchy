{% extends 'base.html.twig' %}
{% block html_body %}


{% set directParent = null %}
/ <a href="{{ path('hierarchy_root') }}" title="">Root</a>
{% for parents in node.parents %}
    {% for parentNode in parents.items %}
        / <a href="{{ path('show_node',{key: parents.type, id:parentNode.id}) }}" title="">
            {{ parents.type }}-{{ parentNode.id }}
        </a>
        {% set directParent = {key: parents.type, id: parentNode.id} %}
    {% endfor %}
{% endfor %} / {{ node.type }}-{{ node.self.id }}

{% if directParent %}
<p>
    <a href="{{ path('show_node', directParent) }}" title="go to parent">..</a>
</p>
{% else %}
<p>
    <a href="{{ path('hierarchy_root') }}" title="go to parent">..</a>
</p>
{% endif %}

<h1>{{ key|capitalize }} {{id}}</h1>

{% if moveTargets is not null %}
<h3>Move to</h3>
<form action="{{ path('move_node',{key: key, id:id}) }}" method="post" accept-charset="utf-8">

    <select name="target_scope-parent">
        {% for target in moveTargets %}
            <option value="{{target.value}}">{% for x in range(0, target.depth) %}&nbsp;&nbsp;{% endfor %}{{ target.label }}</option>
        {% endfor %}
    </select>
    <button name="move">Move</button>
</form>
{% endif %}

<form action="{{ path('update_node',{key: key, id:id}) }}" method="post" accept-charset="utf-8">
    <dl>{% for field in fields %}
        <dt><label for="field_{{field}}">{{field}}</label></dt>
        <dd>
        <input type="text" id="field_{{field}}" name="field[{{field}}]" value="{{ node.self[field] }}">
    {% endfor %}</dd>
    </dl>
    <button>Update</button>
</form>

{% for childKey in childKeys %}
    <h2>{{ childKey }}</h2>


    <form action="{{ path('create_node',{key: childKey}) }}" method="post" accept-charset="utf-8">
        {% if childKey == key %}
            <input type="hidden" name="scope" value="{{ node.self._scope }}">
            <input type="hidden" name="parent" value="{{ id }}">
        {% else %}
            <input type="hidden" name="scope" value="{{ id }}">
        {% endif %}
        {% for field in childFields[childKey] %}
            <input type="text" name="field[{{field}}]">
        {% endfor %}
        <button>Create</button>
    </form>


    <table>
        <thead>
            <tr>
                <th>id</th>
                {% for field in childFields[childKey] %}
                    <th>{{ field }}</th>
                {% endfor %}
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
            {% if node['children'][childKey]|length %}
                {% for childNode in node['children'][childKey] %}
                    <tr>
                        <td><a href="{{ path('show_node', {key: childKey, id: childNode.id}) }}">{{ childNode.id }}</a></td>
                        {% for field in childFields[childKey] %}
                            <td>{{ childNode[field] }}</td>
                        {% endfor %}
                        <td>
                             <form action="{{ path('delete_node', {key: childKey, id: childNode.id}) }}" method="post" accept-charset="utf-8">
                                <button>X</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="{{ childFields[childKey]|length + 2 }}">empty</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

{% endfor %}
{% endblock %}