{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{ key.label.singular }} {{ node.id }} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {nodeParents} only %}

<h1>{{ key.label.singular }} {{node.id}}</h1>

{% include 'hierarchy/partials/tabs.html.twig' with {key, node} only %}

<h2>Edit</h2>

{% include 'hierarchy/partials/form_edit.html.twig' with {key, node} only %}

{% if key.nestedKeys|length %}
<h2>Children</h2>
{% endif %}

{% for childKey in key.nestedKeys %}
    <h3>{{ childKey.label.singular }}s</h3>

    {% include 'hierarchy/partials/form_new.html.twig' with {key: childKey, parent:node} only %}

    {% include 'hierarchy/partials/table.html.twig' with {nodeCollection: childNodes.nodesFor(childKey.id), key: childKey, parent: node.pathArgs, listLink: true} only %}
{% endfor %}
{% endblock %}