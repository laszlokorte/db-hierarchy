{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{ node.type }} {{ node.self.id }} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {parentGroups: node.parents, trailing: node.type~'-'~node.self.id} only %}

<h1>{{ key|capitalize }} {{id}}</h1>

<a href="{{ path('edit_node', {key, id}) }}" title="">Edit</a>
<a href="{{ path('ask_delete_node', {key, id}) }}" title="">Delete</a>

{% if moveTargets is not null %}
<h3>Move to</h3>

{% include 'hierarchy/partials/movement.html.twig' with {key, id, moveTargets} only %}

{% endif %}

<h2>Edit</h2>

{% include 'hierarchy/partials/form_edit.html.twig' with {fields, key, id, values: node.self} only %}

{% if childKeys|length %}
<h2>Children</h2>
{% endif %}

{% for childKey in childKeys %}
    <h3>{{ childKey|capitalize }}s</h3>

    {% include 'hierarchy/partials/form_new.html.twig' with {fields: childFields[childKey], key: childKey, parent:{key,id,scope:node.self._scope}} only %}

    {% include 'hierarchy/partials/table.html.twig' with {fields: childFields[childKey], nodes: node['children'][childKey], key: childKey, parent: {key, id}, listLink: true} only %}
{% endfor %}
{% endblock %}