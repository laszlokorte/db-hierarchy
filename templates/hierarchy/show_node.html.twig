{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{ key.label.singular }} {{ node.id }} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,key, parentNodes} only %}

<h1>
<span data-prefix="{{key.label.singular}}">{{ key.summarize(node) }}</span>
</h1>


{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy,key, node, active: 'show'} only %}

{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: 'fields', tabs: [
{label: 'Fields', default: true},
{label: 'Edit'},
]} %}
  {% block tab_0 %}
        {% include 'hierarchy/partials/fields.html.twig' with {hierarchy,key, node} only %}
  {% endblock %}
  {% block tab_1 %}
     {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, update: node.newUpdate} only %}
  {% endblock %}
{% endembed %}



{% if key.nestedKeys|length %}
<h2>Children</h2>
{% endif %}

{% for childKey in key.nestedKeys %}

{% if childKey.isSingleton %}
<h3>{{ childKey.label.singular }}</h3>

{% for childId in childNodes.nodesFor(childKey.id).ids %}
{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: childKey.id~'-'~childId, tabs: [
{label: childKey.label.empty, activeClasses: 'need-confirmation'},
{label: childKey.label.plural, default: true},
{label: 'Edit', activeClasses: 'need-confirmation'},
]} %}

{% block head %}
    <li class="quicktab-list-item">
        <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId: childId}) }}" title="">Details&hellip;</a>
    </li>
{% endblock %}
  {% block tab_0 %}
    <p>
        Are you sure?
    </p>

    <form action="{{ path('delete_node',{hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId:childId}) }}" method="post" accept-charset="utf-8">
    <dl class="form-container">
        <dt class="form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <button name="soft" class="action-button danger">Yes, Delete!</button>
            <label class="link-button" for="{{defaultTabId|default(null)}}" class="quicktab-link">
        Cancel
        </label>
        </dd>
    </dl>
    </form>
  {% endblock %}
  {% block tab_1 %}
    {% include 'hierarchy/partials/fields.html.twig' with {hierarchy,key: childKey, node: childNodes.nodesFor(childKey.id).getNode(childId)} only %}

  {% endblock %}
  {% block tab_2 %}
    {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, update: childNodes.nodesFor(childKey.id).getNode(childId).newUpdate, force_then: true, then: 'parent', cancel: true, cancel_tab: defaultTabId|default(null)} only %}
  {% endblock %}
{% endembed %}
{% else %}
{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: childKey.id, tabs: [
{label: childKey.label.empty, default: true},
{label: childKey.label.plural, activeClasses: 'need-confirmation'},
]} %}
{% block tab_0 %}
{% endblock %}
{% block tab_1 %}
{% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, creation: childKey.newCreation(node), force_then: true, then: 'parent', cancel_tab: defaultTabId|default(null)} only %}
{% endblock %}
{% endembed %}

{% endfor %}
{% else %}
<h3>{{ childKey.label.plural }}</h3>

{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: childKey.id, tabs: [
{label: 'List', default: true},
{label: 'New'},
]} %}
{% block tab_0 %}
{% include 'hierarchy/partials/table.html.twig' with {hierarchy,nodeCollection: childNodes.nodesFor(childKey.id), key: childKey, parent: node.pathArgs, listLink: true, then: 'parent'} only %}
{% endblock %}
{% block tab_1 %}
 {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, creation: childKey.newCreation(node)} only %}
{% endblock %}
{% endembed %}
{% endif %}
{% endfor %}
{% endblock %}