{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{ node.type }} {{ node.self.id }} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump_.html.twig' with {parentGroups: node.parents, trailing: node.type~'-'~node.self.id} only %}

<h1>{{ key.label.singular }} {{id}}</h1>

<a href="{{ path('edit_node', {key:key.id, id}) }}" title="">Edit</a>
<a href="{{ path('ask_delete_node', {key:key.id, id}) }}" title="">Delete</a>

{% if moveTargets is not null %}
<h3>Move to</h3>

{% include 'hierarchy/partials/movement.html.twig' with {key:key.id, id, moveTargets} only %}

{% endif %}

<h2>Edit</h2>

{% include 'hierarchy/partials/form_edit_.html.twig' with {key, id, values: node.self} only %}

{% if key.nestedKeys|length %}
<h2>Children</h2>
{% endif %}

{% for childKey in key.nestedKeys %}
    <h3>{{ childKey.label.singular }}s</h3>

    {% include 'hierarchy/partials/form_new_.html.twig' with {key: childKey, parent:{key,id,scope:node.self._scope}} only %}

    {% include 'hierarchy/partials/table_.html.twig' with {nodes: node['children'][childKey.id], key: childKey, parent: {key:key.id, id}, listLink: true} only %}
{% endfor %}
{% endblock %}