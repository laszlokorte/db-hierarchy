{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{childKey|capitalize}}s - {{ parent() }}
{%- endblock %}

{% block area_main %}

/ <a href="{{ path('hierarchy_root') }}" title="">Root</a>
{% for parents in node.parents %}
    {% for parentNode in parents.items %}
        / <a href="{{ path('show_node',{key: parents.type, id:parentNode.id}) }}" title="">
            {{ parents.type }}-{{ parentNode.id }}
        </a>
        {% set directParent = {key: parents.type, id: parentNode.id} %}
    {% endfor %}
{% endfor %} / <a href="{{ path('show_node',{key, id:node.self.id}) }}" title="">{{ node.type }}-{{ node.self.id }}</a> / {{ childKey }}s

<h1>{{childKey|capitalize}}s</h1>

    <form action="{{ path('create_node',{key: childKey}) }}" method="post" accept-charset="utf-8">
    	<input type="hidden" name="scope" value="{{node.self.id}}">
    	<dl class="form-container">{% for field in childFields %}
	        <dt class="form-container-label"><label for="field_{{field}}">{{field|capitalize}}</label></dt>
	        <dd class="form-container-field">
	        <input type="text" id="field_{{field}}" name="field[{{field}}]">
	    {% endfor %}</dd>
	    <dt class="form-container-spaces"></dt>
	    <dd class="form-container-buttons">
    	<button>Create</button>
	    </dd>
	    </dl>
    </form>

    <a href="{{ path('new_child_node', {key,id:node.self.id,childKey}) }}" title="">New {{childKey}}</a>

    <table class="data-table">
        <thead class="data-table-head">
            <tr class="data-table-head-row">
                <th class="data-table-head-cell">id</th>
                {% for field in childFields %}
                    <th class="data-table-head-cell">{{ field }}</th>
                {% endfor %}
                <th class="data-table-head-cell" align="right">actions</th>
            </tr>
        </thead>
        <tbody class="data-table-body">
            {% if childNodes|length %}
                {% for node in childNodes %}
                    <tr class="data-table-row">
                        <td class="data-table-cell"><a href="{{ path('show_node', {key: childKey, id: node.id}) }}">{{ node.id }}</a></td>
                        {% for field in childFields %}
                            <td class="data-table-cell">{{ node[field] }}</td>
                        {% endfor %}
                        <td class="data-table-cell" align="right">
                             <form class="inline-form" action="{{ path('delete_node', {key: childKey, id: node.id}) }}" method="post" accept-charset="utf-8">
                                <button class="inline-button">X</button>
                            </form>
                            <a href="{{ path('ask_delete_node', {key: childKey, id: node.id}) }}" title="">Delete</a>

                            <a href="{{ path('edit_node', {key: childKey, id: node.id}) }}" title="">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr class="data-table-empty-row">
                    <td class="data-table-empty-cell" colspan="{{ childFields|length + 2 }}">empty</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
{% endblock %}