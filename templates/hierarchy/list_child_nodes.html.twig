{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    List {{childKey.label.plural}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy,parentNodes, key} only %}

<h1><span data-prefix="{{key.label.singular}}">{{ key.summarize(node) }}</span></h1>

{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy,key, node, active: 'list', childKey} only %}

<h2>{{childKey.label.string(childKey.isSingleton)}}</h2>

{% if childKey.label.description is not empty %}
<p>
    {{ childKey.label.description }}
</p>
{% endif %}

{% if childKey.isSingleton %}

{% for childId in nodeCollection.ids %}

{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: childKey.id~'-'~childId, tabs: [
{label: childKey.label.empty, activeClasses: 'need-confirmation'},
{label: childKey.label.plural, default: true},
{label: 'Edit', activeClasses: 'need-confirmation'},
]} %}
{% block head %}
    <li class="quicktab-list-item">
        <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId: childId}) }}" title="">Details&hellip;</a>
    </li>
{% endblock %}
{% block tab_0 %}
     <p>
        Are you sure?
    </p>

    <form action="{{ path('delete_node',{hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId:childId}) }}" method="post" accept-charset="utf-8">
    <dl class="form-container">
        <dt class="form-container-spacer"></dt>
        <dd class="form-container-buttons">
            <input type="hidden" name="_then" value="list">
            <button name="soft" class="action-button danger">Yes, Delete!</button>
            <label class="link-button" for="{{defaultTabId|default(null)}}" class="quicktab-link">
        Cancel
        </label>
        </dd>
    </dl>
    </form>
{% endblock %}
{% block tab_1 %}
    {% include 'hierarchy/partials/fields.html.twig' with {hierarchy,key:childKey, node: nodeCollection.getNode(childId)} only %}

{% endblock %}
{% block tab_2 %}
    {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy, update: nodeCollection.getNode(childId).newUpdate, force_then: true, then: 'list', cancel: true, cancel_tab: defaultTabId|default(null)} only %}
{% endblock %}
{% endembed %}
{% else %}

{% embed 'hierarchy/partials/radio_tabs.html.twig' with {groupId: childKey.id, tabs: [
{label: childKey.label.empty, default: true},
{label: childKey.label.plural, activeClasses: 'need-confirmation'},
]} %}
{% block tab_0 %}
{% endblock %}
{% block tab_1 %}

    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'list', force_then: true, cancel_tab: defaultTabId|default(null), creation: childKey.newCreation(node)} only %}
{% endblock %}
{% endembed %}
{% endfor %}
{% else %}



{% include 'hierarchy/partials/sub_tabs.html.twig' with {hierarchy,active: 'list', key, node, childKey} only %}

{% include 'hierarchy/partials/table.html.twig' with {hierarchy,nodeCollection, key: childKey, parent: node.pathArgs, then: 'list'} only %}

<div class="quickform">
<h3>Add </h3>
    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy, then: 'list', creation: childKey.newCreation(node)} only %}
</div>

{% endif %}

{% endblock %}