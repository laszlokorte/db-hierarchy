{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    {{childKey|capitalize}}s - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {parentGroups: node.parents, key, id:node.self.id, trailing: childKey~'s'} only %}

<h1>{{childKey|capitalize}}s</h1>

   
{% include 'hierarchy/partials/form_new.html.twig' with {fields: childFields, key: childKey, parent: {key,id: node.self.id, scope: node.self._scope}, then: 'list'} only %}

{% include 'hierarchy/partials/table.html.twig' with {fields: childFields, nodes: childNodes, key: childKey, parent: {key,id: node.self.id}, then: 'list'} only %}

{% endblock %}