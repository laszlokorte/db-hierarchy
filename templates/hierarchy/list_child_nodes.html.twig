{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    List {{childKey.label.plural}} - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,parentNodes, key} only %}

<h1><span data-prefix="{{key.label.singular}}">{{ key.summarize(node) }}</span></h1>

{% include 'hierarchy/partials/tabs.html.twig' with {hierarchy: hierarchy,key, node, active: 'list', childKey} only %}

<h2>{{childKey.label.string(childKey.isSingleton)}}</h2>

{% if childKey.label.description is not empty %}
<p>
    {{ childKey.label.description }}
</p>
{% endif %}

{% if childKey.isSingleton %}

{% for childId in nodeCollection.ids %}
<div class="tab-container dense">

    <input type="radio" class="tab-container-radio" id="child_tab_{{childKey.id}}_list" name="child_tab_{{childKey.id}}" value="list">
    <div class="tab-container-content">
        
        <ul class="quicktab-list">
            <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_list" class="quicktab-link state-active">
            No
            </label></li>

            <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_new" class="quicktab-link">
            Yes
            </label></li>

            <li class="quicktab-list-item">
                <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId: childId}) }}" title="">Details&hellip;</a>
            </li>
        </ul>

        <p>
            Are you sure?
        </p>

        <form action="{{ path('delete_node',{hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId:childId}) }}" method="post" accept-charset="utf-8">
        <dl class="form-container">
            <dt class="form-container-spacer"></dt>
            <dd class="form-container-buttons">
                <input type="hidden" name="_then" value="list">
                <button name="soft" class="action-button danger">Yes, Delete!</button>
                <label class="link-button" for="child_tab_{{childKey.id}}_new" class="quicktab-link">
            Cancel
            </label>
            </dd>
        </dl>
        </form>
    </div>
    <input type="radio" class="tab-container-radio" id="child_tab_{{childKey.id}}_new" name="child_tab_{{childKey.id}}" value="new" checked>
    <div class="tab-container-content">

    <ul class="quicktab-list">
        <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_list" class="quicktab-link">
        No
        </label></li>

        <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_new" class="quicktab-link state-active">
        Yes
        </label></li>
        
        <li class="quicktab-list-item">
            <a class="quicktab-link extra" href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: childKey.id, nodeId: childId}) }}" title="">Details&hellip;</a>
        </li>
    </ul>


    {% include 'hierarchy/partials/form_edit.html.twig' with {hierarchy: hierarchy,key: childKey, node: nodeCollection.getNode(childId), force_then: true, then: 'list', cancel: true} only %}

    </div>
</div>
{% else %}
<div class="tab-container dense">
    
    <input type="radio" class="tab-container-radio" id="child_tab_{{childKey.id}}_new" name="child_tab_{{childKey.id}}" value="new">
    <div class="tab-container-content">

    <ul class="quicktab-list">
        <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_list" class="quicktab-link">
        No
        </label></li>

        <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_new" class="quicktab-link state-active">
        Yes
        </label></li>
    </ul>


    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy: hierarchy,key: childKey, parent: node, then: 'list', force_then: true, cancel_tab: 'child_tab_'~childKey.id~'_list'} only %}

    </div>

    <input type="radio" class="tab-container-radio" id="child_tab_{{childKey.id}}_list" name="child_tab_{{childKey.id}}" value="list" checked>
    <div class="tab-container-content">
        
        <ul class="quicktab-list">
            <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_list" class="quicktab-link state-active">
            No
            </label></li>

            <li class="quicktab-list-item"><label for="child_tab_{{childKey.id}}_new" class="quicktab-link">
            Yes
            </label></li>
        </ul>
    </div>
</div>
{% endfor %}

{% else %}



{% include 'hierarchy/partials/sub_tabs.html.twig' with {hierarchy: hierarchy,active: 'list', key, node, childKey} only %}

{% include 'hierarchy/partials/table.html.twig' with {hierarchy: hierarchy,nodeCollection, key: childKey, parent: node.pathArgs, then: 'list'} only %}

<div class="quickform">
<h3>Add </h3>
    {% include 'hierarchy/partials/form_new.html.twig' with {hierarchy: hierarchy,key: childKey, parent: node, then: 'list'} only %}
</div>

{% endif %}

{% endblock %}