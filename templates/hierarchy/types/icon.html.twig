{% block field %}
    <select class="form-field compact" name="field[{{field.id}}]" value="{{fieldValue}}">
        {% if field.option('explicit') or not field.isRequired %}
        <option value="">---</option>
        {% endif %}
        {% for value in field.option('values') %}
            <option value="{{value}}" {% if fieldValue==value %} selected="selected"{% endif %}>{{value}}</option>
        {% endfor %}
    </select>
{% endblock %}


{% block cell %}
    {% if fieldValue %}
    <span class="badge" style="background-color: #eee;color:#000">
    <svg class="inline-icon" viewBox="0 0 16 16" fill="currentColor">
        <use href="#{{ fieldValue }}-16" />
    </svg>
    {{ fieldValue }}</span>
    {% endif %}
{% endblock %}

{% block display %}  
    {% if fieldValue %}
     <span class="badge" style="background-color: #eee;color:#000">
     <svg class="inline-icon" viewBox="0 0 16 16" fill="currentColor">
        <use href="#{{ fieldValue }}-16" />
    </svg>
    {{ fieldValue }}</span>
    {% endif %}
{% endblock %}
