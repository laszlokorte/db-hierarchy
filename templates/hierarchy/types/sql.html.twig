{% block field %}
    <textarea class="form-field multiline monospace" type="text" id="field_{{field.id}}" name="field[{{field.id}}]">{{node is defined ? field.readValueOf(node) : ''}}</textarea>
{% endblock %}


{% block cell %}
    {{field.readValueOf(nodeCollection.getNode(nodeId))}}
{% endblock %}

{% block display %}
    {{field.readValueOf(node)}}
{% endblock %}
