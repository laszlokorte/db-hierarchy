{% block field %}
    <input class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}]" value="{{node is defined ? field.readValueOf(node) : ''}}"
    {% if field.getOption('autofillBy') %}
    data-autofill-by="field_{{ field.getOption('autofillBy') }}"
    {% endif %}
    {% if field.getOption('autofillSuffix') %}
    data-autofill-suffix="{{ field.getOption('autofillSuffix') }}"
    {% endif %}
    >
{% endblock %}


{% block cell %}
    {{field.readValueOf(nodeCollection.getNode(nodeId))}}
{% endblock %}

{% block display %}
    {{field.readValueOf(node)}}
{% endblock %}
