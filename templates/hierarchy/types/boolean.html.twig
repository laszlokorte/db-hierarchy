{% block cell %}
    {% if fieldValue is same as(true) %}
        <span class="badge true">yes</span>
    {% elseif fieldValue is same as(false) %}
        <span class="badge false">no</span>
    {% elseif fieldValue is same as(null) %}
    {% else %}
        ???
    {% endif %}
{% endblock %}

