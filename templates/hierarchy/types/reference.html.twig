{% block field %}
    <input type="hidden" name="field[{{field.id}}][key]" value="{{field.getOption('target')}}">
    <input {% if field.isRequired()%} required="required"{%endif%} 
    data-label-singular="{{ field.label.singular }}" 
    data-label-plural="{{ field.label.plural }}" 
    data-label-empty="{{ field.label.empty }}" 
    data-explicit="{{ field.getOption('explicit') }}" 
    data-reference-url="{{ path('show_node_field_options', {hierarchySlug: hierarchy.slug, keyId: field.key.id, fieldId: field.id}|merge( nodeId is defined ? {scopeId: nodeCollection.getNodeScope(nodeId)}: {})) }}" 
    data-new-url="{{ path('new_root_node', {hierarchySlug: hierarchy.slug, keyId: field.getOption('target')}) }}" 
    class="form-field" 
    type="text" 
    id="field_{{field.id}}" 
    name="field[{{field.id}}][id]" 
    value="{{fieldValue.id}}" 
    placeholder="{{field.getOption('target')}} ID" 
    data-style="{{field.getOption('style')}}" 
    data-expand-limit="{{field.getOption('expandLimit')??30}}">

{% endblock %}

{% block cell %}
    {% if fieldValue.id %}
        <span class="type-id"><a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: fieldValue.key, nodeId:fieldValue.id}) }}">{{fieldValue.id}}</a></span>
    {% endif %}
{% endblock %}

{% block display %}
    {% if fieldValue.id %}
        <span class="type-id"><a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: fieldValue.key, nodeId:fieldValue.id}) }}">{{fieldValue.id}}</a></span>
    {% endif %}
{% endblock %}