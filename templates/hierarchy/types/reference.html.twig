{% block field %}
    <input type="hidden" name="field[{{field.id}}][key]" value="{{field.getOption('target')}}">
    <input {% if field.isRequired()%} required="required"{%endif%} 
    data-label-singular="{{ field.label.singular }}" 
    data-label-plural="{{ field.label.plural }}" 
    data-explicit="{{ field.getOption('explicit') }}" 
    data-reference-url="{{ path('list_all_nodes', {hierarchySlug: hierarchy.slug, keyId: field.getOption('target')}) }}" 
    data-new-url="{{ path('new_root_node', {hierarchySlug: hierarchy.slug, keyId: field.getOption('target')}) }}" 
    class="form-field" 
    type="text" 
    id="field_{{field.id}}" 
    name="field[{{field.id}}][id]" 
    value="{{node is defined ? field.readValueOf(node).id : ''}}" 
    placeholder="{{field.getOption('target')}} ID" 
    data-style="{{field.getOption('style')}}" 
    data-expand-limit="{{field.getOption('expandLimit')??30}}">

{% endblock %}

{% block cell %}
    {% set val = field.readValueOf(nodeCollection.getNode(nodeId)) %}
    {% if val %}
        <span class="type-id"><a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: val.key, nodeId:val.id}) }}">{{val.id}}</a></span>
    {% endif %}
{% endblock %}

{% block display %}
    {% set val = field.readValueOf(node) %}
    {% if val %}
        <span class="type-id"><a href="{{ path('show_node', {hierarchySlug: hierarchy.slug, keyId: val.key, nodeId:val.id}) }}">{{val.id}}</a></span>
    {% endif %}
{% endblock %}