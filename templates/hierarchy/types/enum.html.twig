{% block field %}
    {% if field.option('style') == 'compact' %}
    <select class="form-field compact" name="field[{{field.id}}]" value="{{fieldValue}}">
        {% if field.option('explicit') or not field.isRequired %}
        <option value="">---</option>
        {% endif %}
        {% for value in field.option('values') %}
            <option value="{{value}}" {% if fieldValue==value %} selected="selected"{% endif %}>{{value}}</option>
        {% endfor %}
    </select>
    {% else %}
    <ul class="form-choice-list">
        {% for value in field.option('values') %}
        <li class="form-choice-item"><label class="form-choice-label"><input type="radio" name="field[{{field.id}}]" value="{{value}}" {% if fieldValue==value %} checked{% endif %} {%if field.isRequired%} required{%endif%}>{{value}}<i class="marker"></i></label></li>
        {% endfor %}
        {% if field.option('explicit') or not field.isRequired %}
        <li class="form-choice-item"><label class="form-choice-label"><input type="radio" name="field[{{field.id}}]" value="" {%if field.isRequired%} required{%endif%}>None<i class="marker"></i></label></li>
        {% endif %}
    </ul>
    {% endif %}
{% endblock %}


{% block cell %}
    <span class="badge">{{fieldValue}}</span>
{% endblock %}

{% block display %}
    <span class="badge">{{fieldValue}}</span>
{% endblock %}
