{% block field %}
    <input class="form-field.small" type="color" id="field_{{field.id}}" name="field[{{field.id}}]" value="{{fieldValue}}">
{% endblock %}


{% block cell %}
    <span class="badge" style="background-color: {{fieldValue}}">{{fieldValue}}</span>
{% endblock %}

{% block display %}
    <span class="badge" style="background-color: {{fieldValue}}">{{fieldValue}}</span>
    
{% endblock %}
