{% block field %}
    <div style="display: flex; justify-items: stretch; gap: 1em">
        <input placeholder="Lat" class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}][lat]" value="{{node is defined ? field.readValueOf(node).lat : ''}}">
        <input placeholder="Long" class="form-field" type="text" name="field[{{field.id}}][log]" value="{{node is defined ? field.readValueOf(node).log : ''}}">
    </div>
{% endblock %}


{% block cell %}
    {{field.readValueOf(nodeCollection.getNode(nodeId))}}
{% endblock %}

{% block display %}
    {{field.readValueOf(node)}}
{% endblock %}
