{% block field %}
    <div style="display: flex; justify-items: stretch; gap: 1em">
        <input placeholder="Latitude" class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}][lat]" value="{{fieldValue.lat|default('')}}">
        <input placeholder="Longitude" class="form-field" type="text" name="field[{{field.id}}][lon]" value="{{fieldValue.lon|default('')}}">
    </div>
{% endblock %}


{% block cell %}
    {{fieldValue.lat}}/{{fieldValue.lon}}
{% endblock %}

{% block display %}
    {{fieldValue.lat}}/{{fieldValue.lon}}
{% endblock %}
