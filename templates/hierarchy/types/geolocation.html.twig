{% block field %}
    <div style="display: flex; justify-items: stretch; gap: 1em">
        <input placeholder="Lat" class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}][lat]" value="{{fieldValue.lat}}">
        <input placeholder="Long" class="form-field" type="text" name="field[{{field.id}}][log]" value="{{fieldValue.log}}">
    </div>
{% endblock %}


{% block cell %}
    {{fieldValue.lat}}/{{fieldValue.log}}
{% endblock %}

{% block display %}
    {{fieldValue.lat}}/{{fieldValue.log}}
{% endblock %}
