{% block field %}
    <div style="display: flex; justify-items: stretch; gap: 1em">
        <input class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}][start]" value="{{fieldValue.start}}">
        <input class="form-field" type="text" id="field_{{field.id}}" name="field[{{field.id}}][end]" value="{{fieldValue.end}}">
    </div>
{% endblock %}


{% block cell %}
    {{fieldValue.start}}-{{ fieldValue.end }}
{% endblock %}

{% block display %}
    {{fieldValue.start}}-{{ fieldValue.end }}
{% endblock %}
