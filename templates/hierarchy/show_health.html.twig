{% extends 'hierarchy/base.html.twig' %}

{% block html_title -%}
    Health Check  - {{ parent() }}
{%- endblock %}

{% block area_main %}

{% include 'hierarchy/partials/breadcrump.html.twig' with {hierarchy: hierarchy,trailing: 'System'} only %}

<h1>Health Check</h1>


<ul class="quicktab-list">
    {# <li class="quicktab-list-item"><a class="{{ html_classes('quicktab-link', {'state-active': subHierarchy.slug == hierarchy.slug}) }}" href="{{ path('show_health', {hierarchySlug: hierarchy.slug}) }}">{{hierarchy.label.singular}}</a></li> #}
    {% for subSchema in subSchemas %}
        <li class="quicktab-list-item"><a class="{{ html_classes('quicktab-link', {'state-active': subHierarchy.slug == subSchema.slug}) }}" href="{{ path('show_health', {hierarchySlug: hierarchy.slug, subHierarchySlug: subSchema.slug}) }}">{{subSchema.label.singular}}</a></li>
    {% endfor %}
</ul>




<div class="details-summary">
    <div style="margin-left: auto;">
        {{ form_start(repairAllForm) }}
        {{ form_widget(repairAllForm.submit) }}
        {{ form_rest(repairAllForm) }}
        {{ form_end(repairAllForm) }}
    </div>
</div>


{% for d in health %}
    <details class="details">
        <summary class="{{ html_classes('details-summary', {'color-valid': d.valid, 'color-invalid': not d.valid}) }}">
        {{ d.keyId }}

        <div style="margin-left: auto;">
            {{ form_start(repairForms[d.keyId]) }}
            {{ form_widget(repairForms[d.keyId].submit, {label: 'Repair '~d.keyId}) }}
            {{ form_rest(repairForms[d.keyId]) }}
            {{ form_end(repairForms[d.keyId]) }}
        </div>

        </summary>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(25em, 1fr));align-content: stretch;">
        {% for type in d.types %}
            <div>
                <h3 class="{{ html_classes({'color-valid': d.validType(type), 'color-invalid': not d.validType(type)}) }}">{{ type }}</h3>
                <table class="data-table">
                    <thead class="data-table-head">
                        <tr class="data-table-head-row">
                            {% for col in d.columns(type) %}
                            <th class="data-table-head-cell">{{col}}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody class="data-table-body">
                        {% for row in d.rows(type) %}
                            <tr class="data-table-row">
                                {% for col in d.columns(type) %}
                                <td class="data-table-cell" align="center">{{ row[col] }}</td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr class="data-table-empty-row">
                                <td class="data-table-empty-cell" colspan="{{d.columns(type)|length}}">✅ Valid</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endfor %}
        
        </div>
    </details>
{% endfor %}


</div>
{% endblock %}