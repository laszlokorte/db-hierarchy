{% extends 'base.html.twig' %}
{% block html_body %}

    <div style="display: grid; grid-template-columns: 2fr 7fr;">
        <nav>
            <h1><a href="{{ path('hierarchy_root') }}" title="">Hierarchy</a></h1>
            <ul>
                {% for rootKey in rootKeys %}
                    <li><a href="{{ path('list_root_nodes', {key: rootKey}) }}" title="">{{ rootKey|capitalize }}s</a></li>
                {% endfor %}
            </ul>


            <p>
                <a href="{{ path('hierarchy_setup') }}">Schow Schema</a>
            </p>
            <p>
                <a href="{{ path('show_hierarchy_defects') }}">Defects</a>
            </p>
            <p>
                <a href="{{ path('hierarchy_tree') }}">Full Hierarchy</a>
            </p>
        </nav>

        <section>
            {% block area_main %}
        
            {% endblock %}
        </section>
    
    </div>

{% endblock %}