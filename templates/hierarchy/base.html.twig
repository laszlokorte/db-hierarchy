{% extends 'base.html.twig' %}
{% block html_body %}

    <div style="display: grid; gap: 3em; grid-template-columns: 16em 60em; max-width: 80em; margin: 5em auto 5em; justify-content: center;">

        <nav class="site-nav">
            <h1 class="site-title"><a class="stealth-link" href="{{ path('hierarchy_root') }}" title="">Hierarchy Manager</a></h1>
            <ul class="block-list">
                {% for rootKey in rootKeys %}
                <li><a href="{{ path('list_root_nodes', {key: rootKey.id}) }}" title="">{{ rootKey.label.plural }}</a></li>
                {% endfor %}
            </ul>

            <h2 class="site-section-title">System</h2>
            <ul class="block-list">
                <li><a href="{{ path('hierarchy_setup') }}">Show Schema</a></li>
                <li><a href="{{ path('show_diagnosis') }}">Diagnosis</a></li>
                <li><a href="{{ path('hierarchy_tree') }}">Full Hierarchy</a></li>
                <li><span onclick="document.body.classList.toggle('show-quickform');window.localStorage.setItem('quickform', 'true'!=window.localStorage.getItem('quickform'))">Toggle Quickform</span></li>
            </ul>

            <script>
                if(window.localStorage.getItem('quickform') == 'true') {
                    document.body.classList.toggle('show-quickform')
                }
            </script>

            <h2 class="site-section-title">Account</h2>
            <ul class="block-list">
                <li><a href="{{ path('security_logout') }}" title="">Log out</a></li>
            </ul>
        </nav>

        <section>

            {% for label, messages in app.flashes(['error','success']) %}
                {% if messages %}
                <div class="{{ html_classes('flash-message', label) }}" style="grid-column: 1 / -1; align-self: flex-start;">
                    <ul class="plain-list">
                        {% for msg in messages %}
                            <li>{{ msg }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            {% endfor %}
            {% block area_main %}
        
            {% endblock %}
        </section>
    
    </div>

{% endblock %}