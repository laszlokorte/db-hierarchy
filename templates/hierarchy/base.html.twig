{% extends 'base.html.twig' %}

{% block html_body %}



    <div style="width: 100%; display: grid; gap: 5%; grid-template-columns: minmax(min-content, 20%) minmax(30em, 75%); max-width: 80em; margin: 5em auto 5em; justify-content: center; padding: 0 1em">

        {% for label, messages in app.flashes(['error','success']) %}
            {% if messages %}
            <div class="{{ html_classes('flash-message', label) }}" style="grid-column: 1 / -1; align-self: flex-start;">
                <ul class="plain-list">
                    {% for msg in messages %}
                        <li>{{ msg }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        {% endfor %}

        {% include 'hierarchy/navigation.html.twig' with {hierarchy} only %}

        <section style="padding-bottom: 10em;">
            {% block area_main %}
        
            {% endblock %}
        </section>
    
    </div>


    <nav class="global-bar">
        <ul class="global-tabs">
            {% for subSchema in subSchemas %}
                <li class="global-tabs-item"><a class="{{ html_classes('global-tabs-link', {'state-active': hierarchy.slug == subSchema.slug}) }}" href="{{ path('hierarchy_root', {hierarchySlug: subSchema.slug}) }}">{{subSchema.label.singular}}</a></li>
            {% endfor %}
            <li class="global-tabs-item"><a class="{{ html_classes('global-tabs-link', {'state-active': hierarchy.slug == systemHierarchy.slug}) }}" href="{{ path('hierarchy_root', {hierarchySlug: systemHierarchy.slug}) }}">System</a></li>
        </ul>
    </nav>
{% endblock %}