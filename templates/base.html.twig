<!DOCTYPE html>
<html class="html-root">
    <head>
        {% block html_head %}
        <meta charset="UTF-8">
        <title>{% block html_title %}Hierarchy Manager{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block html_stylesheets %}
            {#{{ encore_entry_link_tags('app') }}#}
            <style>
                :root {
                    --favicon-url: url('{{path('favicon_svg')}}');
                    --accent-primary: {{ schemaRoot.label.color  }};
                }
            </style>
            <link rel="stylesheet" type="text/css" href="/style.css">
        {% endblock %}

        {% block html_javascripts %}
            {#{{ encore_entry_script_tags('app') }}#}
        {% endblock %}

        <link rel="icon" href="/favicon.svg">
        {% endblock %}
    </head>
    <body class="html-body">
        {% block html_body %}

            {% block area_main %}
                
            {% endblock %}

        {% endblock %}

        <script defer>
            Array.prototype.forEach.call(document.querySelectorAll('[data-reference-url]'), (el) => {
                el.disabled = true
                const oldValue = el.value
                el.value = ''
                el.placeholder = 'loading...';
                window.fetch(el.dataset.referenceUrl).then((response) => {
                    response.json().then((json) => {
                        if(el.dataset.style === 'expanded' && json['nodes'].length < el.dataset.expandLimit) {
                            const options = document.createDocumentFragment();

                            if(el.dataset.explicit !== false || !el.required) {
                                const input = document.createElement('input')
                                input.setAttribute('value', '');
                                input.setAttribute('type', 'radio');
                                input.setAttribute('name', el.getAttribute('name'))
                                if(oldValue == '') {
                                    input.checked = true
                                }
                                const li = document.createElement('li')
                                li.classList.add('form-choice-item')
                                const label = document.createElement('label')
                                label.classList.add('form-choice-label')
                                const marker = document.createElement('i')
                                marker.classList.add('marker')

                                label.appendChild(input)
                                label.appendChild(document.createTextNode(`None`))
                                label.appendChild(marker)

                                li.appendChild(label)
                                options.appendChild(li)
                            }

                            json['nodes'].forEach(node => {
                                const input = document.createElement('input')
                                input.setAttribute('value', node.id);
                                input.setAttribute('type', 'radio');
                                input.setAttribute('name', el.getAttribute('name'))
                                if(oldValue == node.id) {
                                    input.checked = true
                                }
                                const li = document.createElement('li')
                                li.classList.add('form-choice-item')
                                const label = document.createElement('label')
                                label.classList.add('form-choice-label')
                                const marker = document.createElement('i')
                                marker.classList.add('marker')

                                label.appendChild(input)
                                label.appendChild(document.createTextNode(`${node.label} [${json['key']}-${node.id}]`))
                                label.appendChild(marker)

                                li.appendChild(label)
                                options.appendChild(li)
                            })

                            const list = document.createElement('ul')
                            list.classList.add('form-choice-list')
                            list.appendChild(options)

                            el.parentNode.replaceChild(list, el)
                        } else {
                            const options = document.createDocumentFragment();
                        
                            if(el.dataset.explicit !== false || !el.required) {
                                const nullOpt = document.createElement('option')
                                nullOpt.setAttribute('value', '');
                                nullOpt.appendChild(document.createTextNode(`---`))
                                options.appendChild(nullOpt)
                            }

                            json['nodes'].forEach(node => {
                                const opt = document.createElement('option')
                                opt.setAttribute('value', node.id);
                                opt.appendChild(document.createTextNode(`${node.label} [${json['key']}-${node.id}]`))
                                options.appendChild(opt)
                            })

                            const select = document.createElement('select')
                            select.setAttribute('name', el.getAttribute('name'))
                            select.classList.add(...el.classList)
                            select.required = el.required;
                            select.appendChild(options)
                            select.value = oldValue;

                            el.parentNode.replaceChild(select, el)
                        }
                    })
                })
            })       
        </script>
    </body>
</html>
