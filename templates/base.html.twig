<!DOCTYPE html>
<html class="html-root">
    <head>
        {% block html_head %}
        <meta charset="UTF-8">
        <title>{% block html_title %}Hierarchy Manager{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block html_stylesheets %}
            {#{{ encore_entry_link_tags('app') }}#}
            <style>
                :root {
                    --favicon-url: url(#app-logo), url('{{path('favicon_svg')}}');
                    --accent-primary: {{ schemaRoot.label.color  }};
                }
            </style>
            <link rel="stylesheet" type="text/css" href="/style.css">
        {% endblock %}

        {% block html_javascripts %}
            {#{{ encore_entry_script_tags('app') }}#}
        {% endblock %}

        <link rel="icon" href="/favicon.svg">
        {% endblock %}
    </head>
    <body class="html-body">  
        {% block html_body %}

            {% block area_main %}
                
            {% endblock %}

        {% endblock %}

        <script src="/formfields.js" defer></script>
    </body>
</html>
