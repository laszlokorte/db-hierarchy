<!DOCTYPE html>
<html class="html-root">
    <head>
        {% block html_head %}
        <meta charset="UTF-8">
        <title>{% block html_title %}Hierarchy Manager{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block html_stylesheets %}
            {#{{ encore_entry_link_tags('app') }}#}
            <style>
                .html-root {
                    height: 100%;
                }

                .html-body {
                    height: 100%;
                    margin: 0;
                }

                .data-table {
                    min-width: 100%;
                }
                .data-table-row {
                    
                }

                .data-table-cell {
                    
                }

                .data-table-cell.empty::before {
                    content: '-';
                }

                .data-table-head-cell {
                    border-bottom: 1px solid gray;
                }

                .data-table-head-cell:not([align]) {
                    text-align: left;
                }

                .data-table-foot-cell {
                    border-top: 1px solid gray;
                }

                .data-table-empty-cell {
                    padding: 1em;
                    text-align: center;
                    border: 2px dashed #eee;
                    font-style: italic;
                    color: #aaa;
                }

                .form-container {
                    display: grid;
                    gap: 0.5em;
                    grid-template-columns: max-content auto;
                }

                .inline-form {
                    display: inline-block;
                }

                .inline-button {
                    color: #fff;
                    background: #333;
                    display: inline-block;
                    padding: 1px 0.5em;
                    border: none;
                    border-radius: 3px;
                }

                .icon-link {
                    text-decoration: none;
                }

                .plain-list {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                }

                .flash-message {
                    padding: 1em;
                    margin: 0.5em 0;
                }

                .flash-message.success {
                    background: #ccffcc;
                }

                .prompt-box {
                    border: 3px solid #eee;
                    padding: 2em;
                    background: #fff;
                }

                .prompt-titel {
                    margin: 0 0 1em;
                    text-align: center;
                }

                .prompt-container {
                    height: 100%;
                    display: grid;
                    align-items: center;
                    justify-content: center;
                    background: #333339;
                }

                .prompt-error {
                    text-align: center;
                    color: #a00;
                }

                a:not([class]) {
                    color: #034;
                }

                .breadcrump {
                    display: block;
                    list-style: none;
                    padding: 0;
                    display: flex;
                }

                .breadcrump-item {
                    display: inline-block;
                    padding: 0;
                }

                .breadcrump-item::before {
                    content: '/';
                }
            </style>
        {% endblock %}

        {% block html_javascripts %}
            {#{{ encore_entry_script_tags('app') }}#}
        {% endblock %}
        {% endblock %}
    </head>
    <body class="html-body">
        {% block html_body %}

            {% block area_main %}
                
            {% endblock %}

        {% endblock %}
    </body>
</html>
