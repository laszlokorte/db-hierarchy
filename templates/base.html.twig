<!DOCTYPE html>
<html class="html-root">
    <head>
        {% block html_head %}
        <meta charset="UTF-8">
        <title>{% block html_title %}Hierarchy Manager{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block html_stylesheets %}
            {#{{ encore_entry_link_tags('app') }}#}
            <style>
                .html-root {
                    height: 100%;
                }

                .html-body {
                    height: 100%;
                    margin: 0;
                }

                .data-table {
                    min-width: 100%;
                }

                .data-table-caption {
                    display: none;
                }

                .data-table-row {
                    
                }

                .data-table-cell {
                    
                }

                .data-table-cell.type-id::before {
                    content: '#';
                    font-size: 0.8em;
                    color: #aaa;
                    font-style: italic;
                }

                .data-table-cell.empty {
                    text-align: center;
                    color: #aaa;
                }

                .data-table-cell.empty::before {
                    content: '-';
                }

                .data-table-head-cell {
                    border-bottom: 1px solid gray;
                    white-space: nowrap;
                    padding-right: 1em;
                }

                .data-table-head-cell.spacer {
                    color:  #aaa;
                    font-weight: normal;
                    font-size: 0.8em;
                    padding-right: 1em;
                    padding-left: 1em;
                }

                .data-table-cell.actions {
                    white-space: nowrap;
                }

                .data-table-head-cell:not([align]) {
                    text-align: left;
                }

                .data-table-foot-cell {
                    border-top: 1px solid gray;
                }

                .data-table-empty-cell {
                    padding: 1em;
                    text-align: center;
                    border: 2px dashed #eee;
                    font-style: italic;
                    color: #aaa;
                }

                .form-container {
                    display: grid;
                    grid-template-columns: max-content auto min-content min-content;
                    grid-auto-flow: row;
                    gap: 1em;
                    margin: 0;
                }

                .form-container.dense {
                    grid-template-columns: max-content auto;
                }

                .form-container-field {
                    margin: 0;
                }

                .form-container-label:not(.form-container-spacer)::after {
                    content: ':';
                }

                .form-container-info {
                    margin: 0;
                    display: flex;
                    align-items: center;
                    justify-content: end;
                }

                .form-container-buttons {
                    margin: 0;
                    display: flex;
                    gap:  1em;
                    align-items: center;
                    justify-content: start;
                }

                .form-container-label {
                    display: flex;
                    align-items: start;
                    padding-top: 0.5em;
                    justify-content: end;
                    grid-column: 1;
                    margin-right: 1em;
                }

                .form-container-label.dense {
                    margin-right: 0;
                }

                .keyvalue-container {
                    display: grid;
                    gap: 0.5em;
                    grid-template-columns: max-content min-content auto;
                    grid-auto-flow: row;
                    gap: 1em;
                }

                .keyvalue-container-field {
                    margin: 0;
                    display: flex;
                    align-items: center;
                }

                .keyvalue-container-field.wide {
                    grid-column: span 2
                }

                .keyvalue-container-field.empty::after {
                    content: 'None';
                    color: #aaa;
                    font-style: italic;
                }

                .keyvalue-container-label {
                    display: flex;
                    align-items: center;
                    justify-content: end;
                    grid-column: 1;
                }

                .keyvalue-container-label.top {
                    align-items: start;
                }

                .keyvalue-container-label::after {
                    content: ':';
                }

                .inline-form {
                    display: inline-block;
                }

                .inline-button {
                    color: #fff;
                    background: #034;
                    display: inline-block;
                    width: 1.5em;
                    height: 1.4em;
                    border: none;
                    border-radius: 0.3em;
                    cursor: pointer;
                    display: flex inline;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                    vertical-align: center;
                    font-size: 0.8em;
                    opacity: 0.95;
                }

                .inline-button:hover {
                    opacity: 0.85;
                }

                .inline-button:active {
                    opacity: 1;
                }

                .icon-link {
                    color: #fff;
                    text-decoration: none;
                    border-radius: 100%;
                    background: #034;
                    width: 1.3em;
                    height: 1.3em;
                    display: flex;
                    font-size: 0.8em;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                    vertical-align: center;
                    opacity: 0.95;
                }

                .icon-link:hover {
                    opacity: 0.85;
                }

                .icon-link:active {
                    opacity: 1;
                    position: relative;
                    top: 1px;
                }

                .plain-list {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                }

                .flash-message {
                    padding: 1em;
                    margin: 0 0 1em;
                    text-align: center;
                    animation: 1s 2s fade-out forwards;
                    position: sticky;
                    top: 1em;
                }

                .flash-message.success {
                    background: #ccffcc;
                }

                @keyframes fade-out {
                    0% {
                        opacity: 1;
                    }
                    90% {
                        opacity: 0;
                    }
                    100% {
                        display: none;
                        opacity: 0;
                        pointer-events: none;
                    }
                }

                .prompt-box {
                    border: 1px solid #eee;
                    padding: 2em 2em 1em;
                    background: #fff;
                    box-shadow: 0em 1em 4em -0.5em #0004;
                }

                .prompt-titel {
                    margin: 0 0 1em;
                    text-align: center;
                }

                .prompt-container {
                    height: 100%;
                    display: grid;
                    align-items: center;
                    justify-content: center;
                    background: #333339;
                }

                .prompt-error {
                    text-align: center;
                    color: #a00;
                }

                a:not([class]) {
                    color: #034;
                }

                span[onclick]:not([class]) {
                    color: #034;
                    cursor: pointer;
                    text-decoration: underline;
                }

                .breadcrump {
                    display: block;
                    list-style: none;
                    padding: 0;
                    display: flex;
                    flex-flow: wrap;
                    gap:  0.3em;
                }

                .breadcrump-item {
                    display: inline-block;
                    padding: 0;
                    white-space: nowrap;
                }

                .breadcrump-item::before {
                    content: ' / ';
                }

                .color-valid {
                    color: #0a0;
                }

                .color-invalid {
                    color: #a00;
                }

                .dragger {
                    cursor: move;
                    text-align: center;
                    font-weight: bold;
                }

                .dragger::before {
                    content: '☰';
                }

                .dragger.state-dragging {
                    background: #eee;
                    box-shadow: 0 0 4px #eeee;
                    pointer-events: none;
                }

                .dragger:not(.state-dragging).state-over {
                    background: #ffff88;
                }

                .tab-list {
                    display: flex;
                    list-style: none;
                    padding: 0;
                    margin: 0;
                    gap:  0.5em;
                    border-width: 0 0 1px 0;
                    border-style: solid;
                    border-color: gray;
                    padding: 0 0.2em;
                    background-image: linear-gradient(transparent 50%, #0341);
                }

                .tab-list-item {
                    display: block;
                }

                .tab-link {
                    font-size: 0.9em;
                    display: block;
                    border-style: solid;
                    border-width: 1px 1px 0 1px;
                    border-color: gray;
                    padding: 0.5em 1em;
                    border-radius: 0.1em 0.1em 0 0;
                    background: white;
                    margin-bottom: -1px;
                    border-bottom: 1px solid gray;
                    background: #eee;
                    color: #034;
                    background-image: linear-gradient(transparent 50%, #0001);
                }

                .tab-link:hover {
                    background-color: #f4f4f4;
                }

                .tab-link:focus {
                    background-color: #fff;
                    color: #034;
                }

                .tab-link:active {
                    background-color: #e4e4e4;
                }

                .tab-link.state-active {
                    background: #fff;
                    border-bottom-color: white;
                    text-decoration: none;
                    color: #000;
                    box-shadow: 0 -5px 5px -3px #0342;
                    background-image: none;
                }

                .tab-label {
                    display: block;
                    padding: 0.6em 1em 0;
                    font-size: small;
                    color: #999;
                }

                .quickform {
                    display: none;
                }

                .quickform-inline {
                    display: none;
                }


                body.show-quickform .quickform {
                    display: block;
                }

                body.show-quickform .quickform-inline {
                    display: inline;
                }

                .link-button {
                    padding:  0.7em;
                    cursor: pointer;
                    color: #034;
                    display: inline-block;
                }

                .form-button {
                    display: inline-block;
                    padding:  0.7em 1em;
                    border: 1px solid #0002;
                    cursor: pointer;
                    opacity: 0.95;
                    background: #ddd;
                    color: #000;
                    opacity: 0.95;
                    border-radius: 0.2em;
                    text-align: center;
                }

                .form-button.primary {
                    background: #034;
                    color: #fff;
                }

                .form-button:hover {
                    opacity: 0.85;

                }

                .form-button:active {
                    opacity: 1;
                    position: relative;
                    top: 1px;
                }

                .action-button {
                    display: inline-block;
                    padding:  0.7em 1em;
                    border: 1px solid #0002;
                    cursor: pointer;
                    opacity: 0.95;
                    border-radius: 0.2em;
                    text-align: center;
                }

                .action-button:hover {
                    opacity: 0.85;
                }

                .action-button:active {
                    opacity: 1;
                    position: relative;
                    top: 1px;
                }

                .action-button.danger {
                    background: #a00;
                    color: #fff;
                }

                .form-field {
                    padding:  0.7em;
                    display: block;
                    width: 100%;
                    box-sizing: border-box;
                    min-width: 15em;
                }

                .form-field.compact {
                    width: min-content;
                }

                .form-select {
                    padding:  0.7em;
                    display: block;
                    width: 100%;
                    box-sizing: border-box;
                }

                .form-select.compact {
                    width: min-content;
                }

                .inline-list {
                    display: flex;
                    flex-flow: wrap;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    gap: 0.2em;
                }

                .inline-list.separator > li:not(:last-child):after {
                    content: ', ';
                }

                .warning-box {
                    padding: 1em; 
                    border: 1px solid darkred;
                    background: #fee;
                }

                .approve-box {
                    padding: 1em; 
                    border: 1px solid #04a;
                    background: #def;
                }

                .faded-link {
                    color: #034;
                    opacity: 0.1;
                    transition: opacity 0.05s linear;
                }

                .faded-link:hover {
                    opacity: 1;
                }

                .details {
                    margin: 1em 0;
                    background: #fafafa;
                }

                .details-summary {
                    background: #eee;
                    padding: 1em;
                    border-bottom: 1px solid #ddd;
                    display: flex;
                    align-items: center;
                }

                details>.details-summary {
                    cursor: pointer;
                }

                details>.details-summary::before {
                    content: '⏵';
                }

                details[open]>.details-summary::before {
                    content: '⏷';
                }

                details>.details-summary ~ * {
                    padding: 1em;
                }

                .block-list {
                    display: flex;
                    list-style: none;
                    flex-direction: column;
                    padding: 0 0;
                    margin: 0;
                    gap: 0.3em;
                }

                .block-list .block-list {
                    margin: 0.4em 0 0 2em;
                }

                .site-nav {
                    background: #f0f0f0;
                    padding: 2em;
                    align-self: start;
                    display: flex;
                    flex-direction: column;
                    gap: 1em;
                }

                .site-title {
                    margin: 0;
                    text-decoration: none;
                    font-size: 1.4em;
                }

                .site-section-title {
                    margin: 0;
                    font-size: 1.2em;
                }

                .stealth-link {
                    color: inherit;
                    text-decoration: none;
                }

                .stealth-link:hover {
                    text-decoration: underline;
                    text-decoration-color: #0003;
                }
            </style>
        {% endblock %}

        {% block html_javascripts %}
            {#{{ encore_entry_script_tags('app') }}#}
        {% endblock %}
        {% endblock %}
    </head>
    <body class="html-body">
        {% block html_body %}

            {% block area_main %}
                
            {% endblock %}

        {% endblock %}
    </body>
</html>
