{% extends 'base.html.twig' %}

{% block html_body %}
    <div class="prompt-container" {% if error %} style="--color-a: #f00;--color-b: #533"{% endif %}>

      
    	<div class="prompt-box">
    		<h2 class="prompt-titel">
    		<svg 
    		class="site-title-icon" viewBox="0 0 128 128" width="100" height="100" preserveAspectRatio="xMinYMid meet">
	            {% include 'asset/favicon.svg.twig' with {color: 'currentColor'} only %}
	        </svg>
    		Login
    		</h2>

    		<form action="{{ path('security_login') }}" method="post" accept-charset="utf-8">
    			
    		{% if error %}
    			<p class="prompt-error">
    				{{ error.messageKey|trans(error.messageData, 'security') }}
    			</p>
    		{% endif %}

    			<div class="prompt-body">
    				<dl class="form-container dense">
				        <dt class="form-container-label dense"><label for="">Username</label></dt>
				        <dd class="form-container-field">
				        	<input class="form-field" type="text" name="_username" value="{{lastUsername}}">
				        </dd>
				        <dt class="form-container-label dense"><label for="">Password</label></dt>
				        <dd class="form-container-field">
				        	<input class="form-field" type="password" name="_password">
				        </dd>
				        <dt class="form-container-label form-container-spacer"></dt>
				        <dd class="form-container-buttons">
				        	<input type="hidden" name="_csrf_token"
	        value="{{ csrf_token('authenticate') }}"
	    >
				            <button class="form-button primary">Login</button>
				        </dd>
				    </dl>
    			</div>
    		</form>
    	</div>
    </div>


{% endblock %}